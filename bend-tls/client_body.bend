# client.bend: a TLS 1.3 client (TLS_CHACHA20_POLY1305_SHA256 over x25519) that
# checks the server's certificate chain against a trust anchor and fetches GET /.
#
#   bend gen_client.py && bend client.bend -o client
#   ./client <server-name> <ip> <port> <anchor.der> <unix-time>
#
# <server-name> goes in the ClientHello and must match the certificate; <ip> is
# where the socket connects (the TCP kit has no DNS). Bend has no wall clock, so
# the current Unix time is an argument. client.bend is generated by gen_client.py:
# its socket readers are chains of numbered stages, because Bend's checker takes
# no recursion through IO.

import Base
import ./sha256.bend as S
import ./hkdf.bend as K
import ./x25519.bend as X
import ./p256.bend as P
import ./p384.bend as Q
import ./tls.bend as T
import ./handshake.bend as H
import ./x509.bend as C
import ./crl.bend as CR
import ./rsa.bend as R

# Randomness
# ----------

# the 4 little-endian bytes of w, in front of acc
def io.le(+w: U32, acc: List<&2, U32>) -> List<&2, U32>:
  U32.and(w, 255) <> U32.and(U32.shrn(w, 8n), 255) <> U32.and(U32.shrn(w, 16n), 255)
    <> U32.and(U32.shrn(w, 24n), 255) <> acc

# k random bytes, from IO.random_u32 (4 bytes each; k a multiple of 4)
def io.rand(k: Nat) -> IO(List<&2, U32>):
  match k:
    case 0n:
      IO.pure(List<&2, U32>, Nil{})
    case 1n+p:
      do IO<List<&2, U32>>:
        w : U32 <- IO.try(U32, IO.random_u32())
        rest : List<&2, U32> <- io.rand(p)
        return io.le(w, rest)

# Socket bytes
# ------------

# the next record, whole, with the bytes after it and the socket
def io.record(s: Socket, buf: List<&2, U32>) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  do IO<Socket & List<&2, U32> & List<&2, U32>>:
    h : Socket & List<&2, U32> <- io.fill(s, buf, 5n)
    io.record.body(h)

def io.record.body(h: Socket & List<&2, U32>) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  (s, b) = h
  io.record.need(s, b)

# the record whose header starts b: fill up to its length, then cut it off
def io.record.need(s: Socket, +b: List<&2, U32>) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  do IO<Socket & List<&2, U32> & List<&2, U32>>:
    r : Socket & List<&2, U32> <- io.fill(s, b, Nat.add(5n, T.tls.num(2n, List.drop(&2, U32, b, 3n))))
    io.record.done(r, Nat.add(5n, T.tls.num(2n, List.drop(&2, U32, b, 3n))))

# the first n bytes of the buffer (the record) and the rest after them. A connection
# that closes inside a record is an error; closing at a record boundary (an empty
# buffer) is the end of the stream
def io.record.done(r: Socket & List<&2, U32>, +n: Nat) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  (s, b) = r
  io.record.done.split(s, b, n)

def io.record.done.split(s: Socket, +b: List<&2, U32>, +n: Nat) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  io.record.done.at(Bool.or(Nat.is_eq(List.length(&2, U32, b), 0n), Nat.is_le(n, List.length(&2, U32, b))), s, b, n)

def io.record.done.at(ok: Bool, s: Socket, +b: List<&2, U32>, +n: Nat) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  match ok:
    case True{}:
      io.record.cut(s, b, n)
    case False{}:
      do IO<Socket & List<&2, U32> & List<&2, U32>>:
        Socket.close(s)
        IO.die(Socket & List<&2, U32> & List<&2, U32>, 1, "the connection closed inside a record")

def io.record.cut(s: Socket, +b: List<&2, U32>, +n: Nat) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  IO.pure(Socket & List<&2, U32> & List<&2, U32>, (s, (List.drop(&2, U32, b, n), List.take(&2, U32, b, n))))

# sending: the whole data, or the program stops with the peer's error
def io.send.done(m: Socket & Result<&1, &1, (U32 & String) & List<&2, U32>, Unit>) -> IO(Socket):
  (s, r) = m
  match r:
    case Fail{((code, message), rest)}:
      do IO<Socket>:
        Socket.close(s)
        IO.die(Socket, code, message)
    case Done{u}:
      IO.pure(Socket, s)

def io.send(s: Socket, +data: List<&2, U32>) -> IO(Socket):
  do IO<Socket>:
    sent : Socket & Result<&1, &1, (U32 & String) & List<&2, U32>, Unit> <- TCP.send_bytes(s, data)
    io.send.done(sent)

# stops the program, closing the socket first
def io.fail(s: Socket, msg: String) -> IO(Unit):
  do IO<Unit>:
    Socket.close(s)
    IO.die(Unit, 1, msg)

#@@STAGES@@

# The state of a read: bytes not yet read, handshake (or app) bytes so far,
# the server's record sequence number, and whether a record failed to open
# ---------------------------------------------------------------------------

# recs holds the bodies of the records read so far, newest first: adding one is O(1),
# and the flat bytes (fl.acc) are built once when they are needed
type Fl is Data:
  Fl{buf: List<&2, U32>, recs: List<&2, List<&2, U32>>, seq: Nat, bad: Bool}

def fl.buf(+st: Fl) -> List<&2, U32>:
  match st:
    case Fl{+buf, +acc, +seq, +bad}:
      buf

# the record bodies, newest first
def fl.recs(+st: Fl) -> List<&2, List<&2, U32>>:
  match st:
    case Fl{+buf, +recs, +seq, +bad}:
      recs

# the bytes of all the records, oldest first
def fl.acc(+st: Fl) -> List<&2, U32>:
  fl.flat(List.reverse(&2, List<&2, U32>, fl.recs(st)))

# the bodies in order, each appended to the rest (the recursion is over one body)
def fl.flat(+rs: List<&2, List<&2, U32>>) -> List<&2, U32>:
  match rs:
    case Nil{}:
      Nil{}
    case x <> t:
      List.append(&2, U32, x, fl.flat(t))

def fl.seq(+st: Fl) -> Nat:
  match st:
    case Fl{+buf, +acc, +seq, +bad}:
      seq

def fl.bad(+st: Fl) -> Bool:
  match st:
    case Fl{+buf, +acc, +seq, +bad}:
      bad

# one record (header and body) read at the state st: a ChangeCipherSpec record
# (header type 20) is skipped; any other record is opened under key and iv, and
# its content joins the state when its content type is want
def fl.next(+st: Fl, +rest: List<&2, U32>, +rec: List<&2, U32>, +key: List<&2, U32>,
  +iv: List<&2, U32>, +alg: Nat, want: U32) -> Fl:
  fl.next.at(T.tls.tag(rec), st, rest, rec, key, iv, alg, want)

def fl.next.at(hdr: U32, +st: Fl, +rest: List<&2, U32>, +rec: List<&2, U32>,
  +key: List<&2, U32>, +iv: List<&2, U32>, +alg: Nat, want: U32) -> Fl:
  match hdr:
    case 20:
      Fl{rest, fl.recs(st), fl.seq(st), fl.bad(st)}
    case _:
      fl.open(H.hs.open(alg, key, iv, fl.seq(st), rec), st, rest, want)

def fl.open(opened: Maybe<&2, List<&2, U32>>, +st: Fl, +rest: List<&2, U32>, want: U32) -> Fl:
  match opened:
    case Some{pt}:
      fl.inner(H.hs.unpad(pt), st, rest, want)
    case None{}:
      Fl{rest, fl.recs(st), fl.seq(st), True{}}

# an alert (content type 21) ends the stream: a peer's close_notify, or an error
def fl.inner(+inn: H.Inner, +st: Fl, +rest: List<&2, U32>, want: U32) -> Fl:
  match inn:
    case H.Inner{ctype, body}:
      fl.add(U32.is_eq(ctype, 21), U32.is_eq(ctype, want), body, st, rest)

def fl.add(alert: Bool, take: Bool, +body: List<&2, U32>, +st: Fl, +rest: List<&2, U32>) -> Fl:
  match alert:
    case True{}:
      Fl{rest, fl.recs(st), Nat.add(fl.seq(st), 1n), True{}}
    case False{}:
      fl.take(take, body, st, rest)

def fl.take(take: Bool, +body: List<&2, U32>, +st: Fl, +rest: List<&2, U32>) -> Fl:
  match take:
    case True{}:
      Fl{rest, body <> fl.recs(st), Nat.add(fl.seq(st), 1n), fl.bad(st)}
    case False{}:
      Fl{rest, fl.recs(st), Nat.add(fl.seq(st), 1n), fl.bad(st)}

# Handshake messages
# ------------------

# the length of the handshake message at the front of acc (4-byte header included)
def flight.msglen(+acc: List<&2, U32>) -> Nat:
  Nat.add(4n, T.tls.num(3n, List.drop(&2, U32, acc, 1n)))

# the offsets of the messages after the first: Certificate, CertificateVerify, Finished
def flight.off3(+acc: List<&2, U32>) -> Nat:
  Nat.add(flight.msglen(acc), flight.msglen(List.drop(&2, U32, acc, flight.msglen(acc))))

def flight.off4(+acc: List<&2, U32>) -> Nat:
  Nat.add(flight.off3(acc), flight.msglen(List.drop(&2, U32, acc, flight.off3(acc))))

def flight.off5(+acc: List<&2, U32>) -> Nat:
  Nat.add(flight.off4(acc), flight.msglen(List.drop(&2, U32, acc, flight.off4(acc))))

# the body of the message that starts at from (its 4-byte header is skipped)
def flight.msg(+acc: List<&2, U32>, +from: Nat) -> List<&2, U32>:
  List.take(&2, U32, List.drop(&2, U32, acc, Nat.add(from, 4n)),
    Nat.sub(flight.msglen(List.drop(&2, U32, acc, from)), 4n))

# the flight is EncryptedExtensions, Certificate, CertificateVerify, Finished
def flight.kinds(+acc: List<&2, U32>) -> Bool:
  Bool.and(U32.is_eq(T.tls.tag(acc), 8),
    Bool.and(U32.is_eq(T.tls.tag(List.drop(&2, U32, acc, flight.msglen(acc))), 11),
      Bool.and(U32.is_eq(T.tls.tag(List.drop(&2, U32, acc, flight.off3(acc))), 15),
        U32.is_eq(T.tls.tag(List.drop(&2, U32, acc, flight.off4(acc))), 20))))

# the transcript hash of ClientHello, ServerHello and the first n bytes of the flight
def flight.th(+alg: Nat, +acc: List<&2, U32>, +ch: List<&2, U32>, +sh: List<&2, U32>, +n: Nat) -> List<&2, U32>:
  K.hash_of(hello.hl(alg), T.tls.cat(ch, T.tls.cat(sh, List.take(&2, U32, acc, n))))

# the leaf is the first certificate of the chain
def flight.leaf(+chain: List<&2, List<&2, U32>>) -> List<&2, U32>:
  match chain:
    case Nil{}:
      Nil{}
    case +leaf <> more:
      leaf

def flight.second(+chain: List<&2, List<&2, U32>>) -> List<&2, U32>:
  match chain:
    case Nil{}:
      Nil{}
    case +x <> rest:
      flight.leaf(rest)

def flight.chain_ok(+chain: List<&2, List<&2, U32>>, +der: List<&2, U32>, +crl: List<&2, U32>, +host: List<&2, U32>,
  +now: Nat) -> Bool:
  Bool.and(C.x509.verify_server(chain, der <> Nil{}, host, now), CR.crl.chain.ok(chain, der, crl, now))

def flight.verify.at(kinds: Bool, chain: Bool, cv: Bool, fin: Bool) -> Bool:
  Bool.and(kinds, Bool.and(chain, Bool.and(cv, fin)))

# the server's flight: its kinds, its chain (against the anchor at now and for
# host), its CertificateVerify over the transcript through Certificate, and its
# Finished over the transcript through CertificateVerify
def flight.verify(+acc: List<&2, U32>, +ch: List<&2, U32>, +sh: List<&2, U32>, +s_hs: List<&2, U32>,
  +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>, +alg: Nat) -> Bool:
  flight.verify.at(flight.kinds(acc),
    flight.chain_ok(T.tls.certs(flight.msg(acc, flight.msglen(acc))), der, crl, host, now),
    H.hs.cv_ok(flight.leaf(T.tls.certs(flight.msg(acc, flight.msglen(acc)))),
      flight.th(alg, acc, ch, sh, flight.off3(acc)), flight.msg(acc, flight.off3(acc))),
    H.hs.fin_ok(hello.hl(alg), s_hs, flight.th(alg, acc, ch, sh, flight.off4(acc)), flight.msg(acc, flight.off4(acc))))

# true once a complete Finished message is among the messages of acc
def flight.done(+acc: List<&2, U32>) -> Bool:
  flight.scan(1000000n, acc, flight.fin(acc), flight.complete(acc))

def flight.fin(+acc: List<&2, U32>) -> Bool:
  U32.is_eq(T.tls.tag(acc), 20)

def flight.complete(+acc: List<&2, U32>) -> Bool:
  Nat.is_le(flight.msglen(acc), List.length(&2, U32, acc))

def flight.scan(fuel: Nat, +acc: List<&2, U32>, fin: Bool, complete: Bool) -> Bool:
  match fuel:
    case 0n:
      False{}
    case 1n+p:
      match fin complete:
        case True{} True{}:
          True{}
        case True{} False{}:
          False{}
        case False{} False{}:
          False{}
        case False{} True{}:
          flight.scan(p, List.drop(&2, U32, acc, flight.msglen(acc)),
            flight.fin(List.drop(&2, U32, acc, flight.msglen(acc))),
            flight.complete(List.drop(&2, U32, acc, flight.msglen(acc))))

# the flight is over when the state is bad or a Finished is complete (a bad
# state with no Finished is an error, reported after the flight)
def flight.stop(bad: Bool, done: Bool) -> Bool:
  match bad:
    case True{}:
      True{}
    case False{}:
      done

def flight.good(bad: Bool, done: Bool) -> Bool:
  match bad:
    case True{}:
      False{}
    case False{}:
      done

# the flight stages: stage k reads one record while the flight is open (every
# stage calls only the next one)
#@@FLSTAGES@@

# ServerHello
# -----------

# the server's message in the record (its raw bytes, its key share and its group),
# and the record key length of its suite
type SH is Data:
  SH{raw: List<&2, U32>, pub: List<&2, U32>, alg: Nat, group: Nat}

def hello.sh(+m: T.HM) -> SH:
  match m:
    case T.HM{+t, +body, +rest}:
      SH{T.tls.hs(t, body), T.tls.sh.key(body), T.tls.sh.cipher(body), T.tls.sh.group(body)}

# a ServerHello for one of our suites: a HelloRetryRequest selects secp384r1 (24), and a
# ServerHello one of the groups of the first ClientHello's key shares
def hello.ok(+m: T.HM) -> Bool:
  match m:
    case T.HM{+t, +body, +rest}:
      Bool.and(U32.is_eq(t, 2), Bool.and(hello.suite_ok(T.tls.sh.cipher(body)),
        Bool.pick(Bool, hello.is_hrr(body), Nat.is_eq(T.tls.sh.group(body), 24n), hello.group_ok(T.tls.sh.group(body)))))

# the suites we accept: TLS_AES_128_GCM_SHA256 (0x1301), TLS_AES_256_GCM_SHA384 (0x1302) and
# TLS_CHACHA20_POLY1305_SHA256 (0x1303)
def hello.suite_ok(+c: Nat) -> Bool:
  Bool.or(Nat.is_eq(c, 4865n), Bool.or(Nat.is_eq(c, 4866n), Nat.is_eq(c, 4867n)))

# the groups of the first ClientHello's key shares: x25519 (29) and secp256r1 (23)
def hello.group_ok(+g: Nat) -> Bool:
  Bool.or(Nat.is_eq(g, 29n), Bool.or(Nat.is_eq(g, 23n), Nat.is_eq(g, 24n)))

# the hash length of the suite (48 for TLS_AES_256_GCM_SHA384, else 32) and the record key length
# (16 for TLS_AES_128_GCM_SHA256, else 32)
def hello.hl(+alg: Nat) -> Nat:
  Bool.pick(Nat, Nat.is_eq(alg, 4866n), 48n, 32n)

def hello.keylen(+alg: Nat) -> Nat:
  Bool.pick(Nat, Nat.is_eq(alg, 4865n), 16n, 32n)

# the private scalars: privs is the secp256r1 scalar (32 bytes) then the secp384r1 scalar (48 bytes)
# the ClientHello message: an x25519 key share from priv (the base point is 9) and a secp256r1
# key share (04 || x || y). The secp384r1 key share is sent only if a HelloRetryRequest selects it.
def hello.msg(+priv: List<&2, U32>, +privs: List<&2, U32>, +rnd: List<&2, U32>, +host: List<&2, U32>) -> List<&2, U32>:
  T.tls.client_hello(rnd, T.tls.cat(T.tls.share(29, X.x25519(priv, T.tls.cat((9 : U32) <> Nil{}, T.tls.zeros(31n)))),
    T.tls.share(23, List.append(&2, U32, 4 <> Nil{}, P.p256.base_mul(hello.p256_scalar(privs))))), host, Nil{})

def hello.p256_scalar(+privs: List<&2, U32>) -> List<&2, U32>:
  List.take(&2, U32, privs, 32n)

def hello.p384_scalar(+privs: List<&2, U32>) -> List<&2, U32>:
  List.drop(&2, U32, privs, 32n)

def hello.bad(s: Socket) -> IO(Unit):
  io.fail(s, "first server record is not a ServerHello for one of our suites and groups")

def hello.got(t: Socket & List<&2, U32> & List<&2, U32>, +priv: List<&2, U32>, +privs: List<&2, U32>,
  +ch: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  (s, pr) = t
  (rest, rec) = pr
  hello.check(s, rest, rec, priv, privs, ch, der, crl, now, host)

def hello.check(s: Socket, +rest: List<&2, U32>, +rec: List<&2, U32>, +priv: List<&2, U32>,
  +privs: List<&2, U32>, +ch: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  hello.at(Bool.and(U32.is_eq(T.tls.tag(rec), 22), hello.ok(T.tls.hm(List.drop(&2, U32, rec, 5n)))),
    s, rest, rec, priv, privs, ch, der, crl, now, host)

def hello.at(ok: Bool, s: Socket, +rest: List<&2, U32>, +rec: List<&2, U32>, +priv: List<&2, U32>,
  +privs: List<&2, U32>, +ch: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  match ok:
    case True{}:
      hello.kind(hello.hrr_of(T.tls.hm(List.drop(&2, U32, rec, 5n))), s, rest, rec, priv, privs, ch, der, crl, now, host)
    case False{}:
      hello.bad(s)

# a ServerHello that is a HelloRetryRequest (RFC 8446 4.1.4): its random is a fixed value
def hello.is_hrr(+body: List<&2, U32>) -> Bool:
  R.rsa.eqb(T.tls.sh.random(body), T.tls.hrr_random())

def hello.hrr_of(+m: T.HM) -> Bool:
  match m:
    case T.HM{+t, +body, +rest}:
      hello.is_hrr(body)

def hello.kind(hrr: Bool, s: Socket, +rest: List<&2, U32>, +rec: List<&2, U32>, +priv: List<&2, U32>,
  +privs: List<&2, U32>, +ch: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  match hrr:
    case True{}:
      hello.retry(s, rest, hello.sh(T.tls.hm(List.drop(&2, U32, rec, 5n))), priv, privs, ch, der, crl, now, host)
    case False{}:
      hello.derive(s, rest, hello.sh(T.tls.hm(List.drop(&2, U32, rec, 5n))), priv, privs, ch, der, crl, now, host)

# a HelloRetryRequest that selects secp384r1, the one group we sent no key share for: the second
# ClientHello sends that key share and echoes the cookie. Any other group is refused.
def hello.retry(s: Socket, +rest: List<&2, U32>, +sh: SH, +priv: List<&2, U32>, +privs: List<&2, U32>,
  +ch: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  match sh:
    case SH{+raw, +pub, +alg, +group}:
      hello.retry.at(Nat.is_eq(group, 24n), s, rest, raw, alg, priv, privs, ch, der, crl, now, host)

def hello.retry.at(is384: Bool, s: Socket, +rest: List<&2, U32>, +hrr: List<&2, U32>, +alg: Nat,
  +priv: List<&2, U32>, +privs: List<&2, U32>, +ch: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat,
  +host: List<&2, U32>) -> IO(Unit):
  match is384:
    case True{}:
      hello.retry.send(s, rest, hrr, alg, priv, privs, ch, der, crl, now, host)
    case False{}:
      hello.bad(s)

# the second ClientHello, sent; then the next record, which must be the ServerHello
def hello.retry.send(s: Socket, +rest: List<&2, U32>, +hrr: List<&2, U32>, +alg: Nat, +priv: List<&2, U32>,
  +privs: List<&2, U32>, +ch: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  do IO<Unit>:
    +ch2 : List<&2, U32> = hello.msg2(privs, hello.random(ch), host, hello.cookie(hrr))
    +pre : List<&2, U32> = T.tls.cat(hello.synth(alg, ch), T.tls.cat(hrr, ch2))
    s1 : Socket <- io.send(s, T.tls.plain(22, ch2))
    t : Socket & List<&2, U32> & List<&2, U32> <- io.record(s1, rest)
    hello.round2.first(t, priv, privs, pre, der, crl, now, host)

def hello.round2.first(t: Socket & List<&2, U32> & List<&2, U32>, +priv: List<&2, U32>, +privs: List<&2, U32>,
  +pre: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  (s, pr) = t
  (rest, rec) = pr
  hello.round2.check(s, rest, rec, priv, privs, pre, der, crl, now, host)

def hello.round2.check(s: Socket, +rest: List<&2, U32>, +rec: List<&2, U32>, +priv: List<&2, U32>,
  +privs: List<&2, U32>, +pre: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  hello.round2.at(U32.is_eq(T.tls.tag(rec), 20), s, rest, rec, priv, privs, pre, der, crl, now, host)

# after the second ClientHello, one change_cipher_spec record (sent for middlebox compatibility)
# is skipped; the record after it must be the ServerHello
def hello.round2.at(is_ccs: Bool, s: Socket, +rest: List<&2, U32>, +rec: List<&2, U32>, +priv: List<&2, U32>,
  +privs: List<&2, U32>, +pre: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  match is_ccs:
    case True{}:
      do IO<Unit>:
        t : Socket & List<&2, U32> & List<&2, U32> <- io.record(s, rest)
        hello.round2.second(t, priv, privs, pre, der, crl, now, host)
    case False{}:
      hello.round2.check2(s, rest, rec, priv, privs, pre, der, crl, now, host)

def hello.round2.second(t: Socket & List<&2, U32> & List<&2, U32>, +priv: List<&2, U32>, +privs: List<&2, U32>,
  +pre: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  (s, pr) = t
  (rest, rec) = pr
  hello.round2.check2(s, rest, rec, priv, privs, pre, der, crl, now, host)

def hello.round2.check2(s: Socket, +rest: List<&2, U32>, +rec: List<&2, U32>, +priv: List<&2, U32>,
  +privs: List<&2, U32>, +pre: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  hello.at2(Bool.and(U32.is_eq(T.tls.tag(rec), 22), hello.ok2(T.tls.hm(List.drop(&2, U32, rec, 5n)))),
    s, rest, rec, priv, privs, pre, der, crl, now, host)

def hello.at2(ok: Bool, s: Socket, +rest: List<&2, U32>, +rec: List<&2, U32>, +priv: List<&2, U32>,
  +privs: List<&2, U32>, +pre: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  match ok:
    case True{}:
      hello.derive(s, rest, hello.sh(T.tls.hm(List.drop(&2, U32, rec, 5n))), priv, privs, pre, der, crl, now, host)
    case False{}:
      hello.bad(s)

# the ServerHello after a HelloRetryRequest: one of our suites, secp384r1, and not a HelloRetryRequest again
def hello.ok2(+m: T.HM) -> Bool:
  match m:
    case T.HM{+t, +body, +rest}:
      Bool.and(U32.is_eq(t, 2), Bool.and(hello.suite_ok(T.tls.sh.cipher(body)),
        Bool.and(Nat.is_eq(T.tls.sh.group(body), 24n), Bool.pick(Bool, hello.is_hrr(body), False{}, True{}))))

# the transcript before the ServerHello after a HelloRetryRequest (RFC 8446 4.4.1): the first
# ClientHello as a message_hash message (type 254, a 3-byte length of the digest, the digest)
def hello.synth(+alg: Nat, +ch: List<&2, U32>) -> List<&2, U32>:
  T.tls.cat(254 <> 0 <> 0 <> U32.from_nat(hello.hl(alg)) <> Nil{}, K.hash_of(hello.hl(alg), ch))

# the random of a ClientHello: after its header (4 bytes) and its version (2 bytes)
def hello.random(+ch: List<&2, U32>) -> List<&2, U32>:
  List.take(&2, U32, List.drop(&2, U32, ch, 6n), 32n)

# the cookie of a HelloRetryRequest (its raw message): without the 2-byte length; Nil when none
def hello.cookie(+raw: List<&2, U32>) -> List<&2, U32>:
  hello.cookie.at(T.tls.hm(raw))

def hello.cookie.at(+m: T.HM) -> List<&2, U32>:
  match m:
    case T.HM{+t, +body, +rest}:
      List.drop(&2, U32, T.tls.ext(T.tls.sh.exts(body), 44n), 2n)

# the second ClientHello: the same random, the secp384r1 key share alone, and the cookie
def hello.msg2(+privs: List<&2, U32>, +rnd: List<&2, U32>, +host: List<&2, U32>, +cookie: List<&2, U32>) -> List<&2, U32>:
  T.tls.client_hello(rnd, T.tls.share(24, List.append(&2, U32, 4 <> Nil{}, Q.p384.base_mul(hello.p384_scalar(privs)))),
    host, cookie)

def hello.derive(s: Socket, +rest: List<&2, U32>, +sh: SH, +priv: List<&2, U32>, +privs: List<&2, U32>,
  +ch: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  match sh:
    case SH{+raw, +pub, +alg, +group}:
      hello.keys(s, rest, raw, pub, alg, group, priv, privs, ch, der, crl, now, host)

# the shared secret of the server's key share: x25519 for group 29, the secp256r1 x coordinate
# for group 23 (its key is 04 || x || y), or the secp384r1 x coordinate for group 24
def hello.dhe(+group: Nat, +priv: List<&2, U32>, +privs: List<&2, U32>, +pub: List<&2, U32>) -> List<&2, U32>:
  hello.dhe.at(Nat.is_eq(group, 29n), Nat.is_eq(group, 24n), priv, privs, pub)

def hello.dhe.at(x25519: Bool, +is384: Bool, +priv: List<&2, U32>, +privs: List<&2, U32>, +pub: List<&2, U32>) -> List<&2, U32>:
  match x25519:
    case True{}:
      X.x25519(priv, pub)
    case False{}:
      hello.dhe.ec(is384, privs, pub)

def hello.dhe.ec(is384: Bool, +privs: List<&2, U32>, +pub: List<&2, U32>) -> List<&2, U32>:
  match is384:
    case True{}:
      Q.p384.ecdh(hello.p384_scalar(privs), List.take(&2, U32, List.drop(&2, U32, pub, 1n), 48n), List.drop(&2, U32, pub, 49n))
    case False{}:
      P.p256.ecdh(hello.p256_scalar(privs), List.take(&2, U32, List.drop(&2, U32, pub, 1n), 32n), List.drop(&2, U32, pub, 33n))

# the handshake keys (RFC 8446 7.1): the handshake secret from the x25519
# exchange, the client and server handshake traffic secrets over the transcript
# through ServerHello, and the master secret
def hello.keys(s: Socket, +rest: List<&2, U32>, +raw: List<&2, U32>, +pub: List<&2, U32>,
  +alg: Nat, +group: Nat, +priv: List<&2, U32>, +privs: List<&2, U32>, +ch: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> IO(Unit):
  do IO<Unit>:
    +hl : Nat = hello.hl(alg)
    +th1 : List<&2, U32> = K.hash_of(hl, T.tls.cat(ch, raw))
    +hsec : List<&2, U32> = H.hs.hs_secret_dhe(hl, hello.dhe(group, priv, privs, pub))
    +c_hs : List<&2, U32> = K.derive_secret(hl, hsec, "c hs traffic", th1)
    +s_hs : List<&2, U32> = K.derive_secret(hl, hsec, "s hs traffic", th1)
    +mst : List<&2, U32> = K.master_secret(hl, hsec)
    flight.start(s, rest, c_hs, s_hs, mst, ch, raw, der, crl, now, host, alg)

# the server's flight, read from rest with the server handshake keys
def flight.start(s: Socket, +rest: List<&2, U32>, +c_hs: List<&2, U32>, +s_hs: List<&2, U32>,
  +mst: List<&2, U32>, +ch: List<&2, U32>, +sh: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat,
  +host: List<&2, U32>, +alg: Nat) -> IO(Unit):
  do IO<Unit>:
    +key : List<&2, U32> = K.traffic_keyn(hello.hl(alg), s_hs, hello.keylen(alg))
    +iv : List<&2, U32> = K.traffic_iv(hello.hl(alg), s_hs)
    r : Socket & Fl <- f0.at(False{}, s, Fl{rest, Nil{}, 0n, False{}}, key, iv, alg)
    flight.finish(r, c_hs, s_hs, mst, ch, sh, der, crl, now, host, alg)

def flight.finish(t: Socket & Fl, +c_hs: List<&2, U32>, +s_hs: List<&2, U32>, +mst: List<&2, U32>,
  +ch: List<&2, U32>, +sh: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat, +host: List<&2, U32>, +alg: Nat) -> IO(Unit):
  (s, st) = t
  flight.finish.go(s, st, c_hs, s_hs, mst, ch, sh, der, crl, now, host, alg)

def flight.finish.go(s: Socket, +st: Fl, +c_hs: List<&2, U32>, +s_hs: List<&2, U32>,
  +mst: List<&2, U32>, +ch: List<&2, U32>, +sh: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat,
  +host: List<&2, U32>, +alg: Nat) -> IO(Unit):
  flight.finish.at(flight.good(fl.bad(st), flight.done(fl.acc(st))), s, st, c_hs, s_hs, mst, ch, sh,
    der, crl, now, host, alg)

def flight.finish.at(ok: Bool, s: Socket, +st: Fl, +c_hs: List<&2, U32>, +s_hs: List<&2, U32>,
  +mst: List<&2, U32>, +ch: List<&2, U32>, +sh: List<&2, U32>, +der: List<&2, U32>, +crl: List<&2, U32>, +now: Nat,
  +host: List<&2, U32>, +alg: Nat) -> IO(Unit):
  match ok:
    case True{}:
      flight.finish.check(flight.verify(fl.acc(st), ch, sh, s_hs, der, crl, now, host, alg), s, st, c_hs, mst, ch, sh, host, alg)
    case False{}:
      io.fail(s, "the server's flight is incomplete or a record did not open")

def flight.finish.check(v: Bool, s: Socket, +st: Fl, +c_hs: List<&2, U32>, +mst: List<&2, U32>,
  +ch: List<&2, U32>, +sh: List<&2, U32>, +host: List<&2, U32>, +alg: Nat) -> IO(Unit):
  match v:
    case True{}:
      client.finish(s, st, c_hs, mst, ch, sh, host, alg)
    case False{}:
      io.fail(s, "the server's certificate, CertificateVerify or Finished did not check")

# Our Finished, the request, and the response
# -------------------------------------------

# the client's Finished under c_hs, then the GET under the application keys
def client.finish(s: Socket, +st: Fl, +c_hs: List<&2, U32>, +mst: List<&2, U32>,
  +ch: List<&2, U32>, +sh: List<&2, U32>, +host: List<&2, U32>, +alg: Nat) -> IO(Unit):
  do IO<Unit>:
    +hl : Nat = hello.hl(alg)
    +thf : List<&2, U32> = flight.th(alg, fl.acc(st), ch, sh, flight.off5(fl.acc(st)))
    +ckey : List<&2, U32> = K.traffic_keyn(hl, c_hs, hello.keylen(alg))
    +civ : List<&2, U32> = K.traffic_iv(hl, c_hs)
    +fin : List<&2, U32> = T.tls.hs(20, K.finished_mac(hl, c_hs, thf))
    s1 : Socket <- io.send(s, T.tls.seal(alg, ckey, civ, 0n, 22, fin))
    +capsec : List<&2, U32> = K.derive_secret(hl, mst, "c ap traffic", thf)
    +sapsec : List<&2, U32> = K.derive_secret(hl, mst, "s ap traffic", thf)
    s2 : Socket <- io.send(s1, T.tls.seal(alg, K.traffic_keyn(hl, capsec, hello.keylen(alg)), K.traffic_iv(hl, capsec), 0n, 23, client.req(host)))
    app.start(s2, fl.buf(st), K.traffic_keyn(hl, sapsec, hello.keylen(alg)), K.traffic_iv(hl, sapsec), alg)

# the request: GET / with the host and Connection: close
def client.req(+host: List<&2, U32>) -> List<&2, U32>:
  T.tls.cat(S.bytes_of("GET / HTTP/1.1\r\nHost: "), T.tls.cat(host, S.bytes_of("\r\nConnection: close\r\n\r\n")))

# the application records, read until the peer closes or a record does not open
def app.start(s: Socket, +rest: List<&2, U32>, +key: List<&2, U32>, +iv: List<&2, U32>, +alg: Nat) -> IO(Unit):
  do IO<Unit>:
    t : Socket & Fl <- g0.at(False{}, s, Fl{rest, Nil{}, 0n, False{}}, key, iv, alg)
    app.end(t)

def app.end(t: Socket & Fl) -> IO(Unit):
  (s, st) = t
  app.print(s, st)

def app.print(s: Socket, +st: Fl) -> IO(Unit):
  do IO<Unit>:
    Socket.close(s)
    IO.print(utf8(fl.acc(st)))

# the stage chain for application records (every stage calls only the next one)
#@@APPSTAGES@@

# Main
# ----

# a nonnegative decimal argument
def arg.nat(s: String, +acc: Nat) -> Nat:
  match s:
    case SNil{}:
      acc
    case SCon{Chr{c}, t}:
      arg.nat(t, Nat.add(Nat.mul(acc, 10n), Nat.sub(U32.to_nat(c), 48n)))

# the bytes of a file (as in bench.bend)
def anchor.got(q: File & Result<&1, &1, U32 & String, List<&2, U32>>) -> IO(List<&2, U32>):
  (f, r) = q
  do IO<List<&2, U32>>:
    File.close(f)
    IO.pass(List<&2, U32>, r)

def anchor.size(p: File & Result<&1, &1, U32 & String, U32>) -> IO(List<&2, U32>):
  (f, r) = p
  do IO<List<&2, U32>>:
    n : U32 <- IO.pass(U32, r)
    q : File & Result<&1, &1, U32 & String, List<&2, U32>> <- File.read_bytes(f, (n + 1 : U32))
    anchor.got(q)

def anchor.read(path: String) -> IO(List<&2, U32>):
  do IO<List<&2, U32>>:
    f : File <- IO.try(File, File.open(path, "r"))
    p : File & Result<&1, &1, U32 & String, U32> <- File.size(f)
    anchor.size(p)

def run(name: String, ip: String, port: Nat, path: String, crlpath: String, now: Nat) -> IO(Unit):
  do IO<Unit>:
    der : List<&2, U32> <- anchor.read(path)
    crl : List<&2, U32> <- crl.file(crlpath)
    sock : Socket <- IO.try(Socket, TCP.connect(ip, U32.from_nat(port)))
    +host : List<&2, U32> = S.bytes_of(name)
    +priv : List<&2, U32> <- io.rand(8n)
    +privr : List<&2, U32> <- io.rand(8n)
    +privq : List<&2, U32> <- io.rand(12n)
    +privs : List<&2, U32> = List.append(&2, U32, P.p256.scalar(privr), Q.p384.scalar(privq))
    +rnd : List<&2, U32> <- io.rand(8n)
    +ch : List<&2, U32> = hello.msg(priv, privs, rnd, host)
    s1 : Socket <- io.send(sock, T.tls.plain(22, ch))
    t : Socket & List<&2, U32> & List<&2, U32> <- io.record(s1, Nil{})
    hello.got(t, priv, privs, ch, der, crl, now, host)

# the CRL file, or no CRL (Nil) when no path is given
def crl.file(+path: String) -> IO(List<&2, U32>):
  crl.file.at(String.eq(path, ""), path)

def crl.file.at(none: Bool, +path: String) -> IO(List<&2, U32>):
  match none:
    case True{}:
      IO.pure(List<&2, U32>, Nil{})
    case False{}:
      anchor.read(path)

def start(args: List<String>) -> IO(Unit):
  match args:
    case prog <> (name <> (ip <> (port <> (path <> (now <> (crlp <> Nil{})))))):
      run(name, ip, arg.nat(port, 0n), path, crlp, arg.nat(now, 0n))
    case prog <> (name <> (ip <> (port <> (path <> (now <> Nil{}))))):
      run(name, ip, arg.nat(port, 0n), path, "", arg.nat(now, 0n))
    case _:
      IO.print("usage: client <server-name> <ip> <port> <anchor.der> <unix-time> [crl.der]")

def main() -> IO(Unit):
  do IO<Unit>:
    args : List<String> <- IO.args()
    start(args)

# UTF-8 decoding, as in demos/io_http_fetch (the response bytes to text)
type Utf8 is Data:
  Utf8{left: U32, code: U32, low: U32, high: U32, text: String}

def utf8_start(+b: U32, +text: String) -> Utf8:
  +left = Bool.pick(U32, U32.is_lt(b, 224), 1,
    Bool.pick(U32, U32.is_lt(b, 240), 2, 3))
  Bool.pick(Utf8, U32.is_lt(b, 128),
    Utf8{0, 0, 128, 191, SCon{Chr{b}, text}},
    Bool.pick(Utf8, Bool.or(U32.is_lt(b, 194), U32.is_gt(b, 244)),
      Utf8{0, 0, 128, 191, SCon{Chr{65533}, text}},
      Utf8{left, U32.and(b, U32.shrn(63, U32.to_nat(left))),
        Bool.pick(U32, U32.is_eq(b, 224), 160,
          Bool.pick(U32, U32.is_eq(b, 240), 144, 128)),
        Bool.pick(U32, U32.is_eq(b, 237), 159,
          Bool.pick(U32, U32.is_eq(b, 244), 143, 191)), text}))

def utf8_more(+b: U32, +left: U32, +code: U32, +text: String,
  valid: Bool) -> Utf8:
  match valid:
    case False{}:
      utf8_start(b, SCon{Chr{65533}, text})
    case True{}:
      +next = U32.sub(left, 1)
      +value = U32.or(U32.shln(code, 6n), U32.and(b, 63))
      Utf8{next, value, 128, 191,
        Bool.pick(String, U32.is_zero(next), SCon{Chr{value}, text}, text)}

def utf8_byte(state: Utf8, +b: U32) -> Utf8:
  match state:
    case Utf8{left, code, low, high, text}:
      match left:
        case 0:
          utf8_start(b, text)
        case _:
          utf8_more(b, left, code, text,
            Bool.and(U32.is_ge(b, low), U32.is_le(b, high)))

def utf8_finish(state: Utf8) -> String:
  match state:
    case Utf8{left, code, low, high, +text}:
      String.reverse(Bool.pick(String, U32.is_zero(left), text,
        SCon{Chr{65533}, text}))

def utf8(bytes: List<&2, U32>) -> String:
  utf8_finish(List.foldl(~&2, ~U32, ~Utf8, ~(state => b => utf8_byte(state, b)), bytes,
    Utf8{0, 0, 128, 191, ""}))
