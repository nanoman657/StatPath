# sha512.bend: SHA-512 (FIPS 180-4) over byte lists (U32 values 0..255). A 64-bit
# word is W{hi, lo}, two 32-bit halves; the rotations and shifts split across them.
# The constants are generated by gen_sha512.py, which checks them against hashlib.
# sha512.bend is generated: python3 -I gen_sha512.py

import Base

type W is Data:
  W{hi: U32, lo: U32}

# the 8 working words a..h of the compression
type ST is Data:
  ST{a: W, b: W, c: W, d: W, e: W, f: W, g: W, h: W}

# the last 16 message words, W[t-16] first
type WIN is Data:
  WIN{w0: W, w1: W, w2: W, w3: W, w4: W, w5: W, w6: W, w7: W,
    w8: W, w9: W, w10: W, w11: W, w12: W, w13: W, w14: W, w15: W}

def sha512.K() -> List<&2, W>:
  [W{1116352408, 3609767458}, W{1899447441, 602891725}, W{3049323471, 3964484399}, W{3921009573, 2173295548}, W{961987163, 4081628472}, W{1508970993, 3053834265}, W{2453635748, 2937671579}, W{2870763221, 3664609560}, W{3624381080, 2734883394}, W{310598401, 1164996542}, W{607225278, 1323610764}, W{1426881987, 3590304994}, W{1925078388, 4068182383}, W{2162078206, 991336113}, W{2614888103, 633803317}, W{3248222580, 3479774868}, W{3835390401, 2666613458}, W{4022224774, 944711139}, W{264347078, 2341262773}, W{604807628, 2007800933}, W{770255983, 1495990901}, W{1249150122, 1856431235}, W{1555081692, 3175218132}, W{1996064986, 2198950837}, W{2554220882, 3999719339}, W{2821834349, 766784016}, W{2952996808, 2566594879}, W{3210313671, 3203337956}, W{3336571891, 1034457026}, W{3584528711, 2466948901}, W{113926993, 3758326383}, W{338241895, 168717936}, W{666307205, 1188179964}, W{773529912, 1546045734}, W{1294757372, 1522805485}, W{1396182291, 2643833823}, W{1695183700, 2343527390}, W{1986661051, 1014477480}, W{2177026350, 1206759142}, W{2456956037, 344077627}, W{2730485921, 1290863460}, W{2820302411, 3158454273}, W{3259730800, 3505952657}, W{3345764771, 106217008}, W{3516065817, 3606008344}, W{3600352804, 1432725776}, W{4094571909, 1467031594}, W{275423344, 851169720}, W{430227734, 3100823752}, W{506948616, 1363258195}, W{659060556, 3750685593}, W{883997877, 3785050280}, W{958139571, 3318307427}, W{1322822218, 3812723403}, W{1537002063, 2003034995}, W{1747873779, 3602036899}, W{1955562222, 1575990012}, W{2024104815, 1125592928}, W{2227730452, 2716904306}, W{2361852424, 442776044}, W{2428436474, 593698344}, W{2756734187, 3733110249}, W{3204031479, 2999351573}, W{3329325298, 3815920427}, W{3391569614, 3928383900}, W{3515267271, 566280711}, W{3940187606, 3454069534}, W{4118630271, 4000239992}, W{116418474, 1914138554}, W{174292421, 2731055270}, W{289380356, 3203993006}, W{460393269, 320620315}, W{685471733, 587496836}, W{852142971, 1086792851}, W{1017036298, 365543100}, W{1126000580, 2618297676}, W{1288033470, 3409855158}, W{1501505948, 4234509866}, W{1607167915, 987167468}, W{1816402316, 1246189591}]

def sha512.IV() -> ST:
  ST{W{1779033703, 4089235720}, W{3144134277, 2227873595}, W{1013904242, 4271175723}, W{2773480762, 1595750129}, W{1359893119, 2917565137}, W{2600822924, 725511199}, W{528734635, 4215389547}, W{1541459225, 327033209}}

def sha512.IV384() -> ST:
  ST{W{3418070365, 3238371032}, W{1654270250, 914150663}, W{2438529370, 812702999}, W{355462360, 4144912697}, W{1731405415, 4290775857}, W{2394180231, 1750603025}, W{3675008525, 1694076839}, W{1203062813, 3204075428}}


# Word operations
# ---------------

def w.add.at(+lo: U32, hih: U32, xl: U32) -> W:
  W{U32.add(hih, Bool.to_u32(U32.is_lt(lo, xl))), lo}

def w.add(+x: W, +y: W) -> W:
  match x:
    case W{+xh, +xl}:
      match y:
        case W{+yh, +yl}:
          w.add.at(U32.add(xl, yl), U32.add(xh, yh), xl)

# the sum's low half is lo; a carry out of the low halves (lo < xl) adds 1 to the high half
def w.xor(+x: W, +y: W) -> W:
  match x:
    case W{+xh, +xl}:
      match y:
        case W{+yh, +yl}:
          W{U32.xor(xh, yh), U32.xor(xl, yl)}

def w.and(+x: W, +y: W) -> W:
  match x:
    case W{+xh, +xl}:
      match y:
        case W{+yh, +yl}:
          W{U32.and(xh, yh), U32.and(xl, yl)}

def w.not(+x: W) -> W:
  match x:
    case W{+xh, +xl}:
      W{U32.not(xh), U32.not(xl)}

def w.swap(+x: W) -> W:
  match x:
    case W{+xh, +xl}:
      W{xl, xh}

# a rotation by n in 1..31 (the halves exchange bits across the boundary)
def w.rot.small(+x: W, +n: Nat) -> W:
  match x:
    case W{+xh, +xl}:
      W{U32.or(U32.shrn(xh, n), U32.shln(xl, Nat.sub(32n, n))),
        U32.or(U32.shrn(xl, n), U32.shln(xh, Nat.sub(32n, n)))}

# a rotation by n in 1..63: by 32 or more, the halves swap first
def w.rotr.at(big: Bool, +x: W, n: Nat) -> W:
  match big:
    case True{}:
      w.rot.small(w.swap(x), Nat.sub(n, 32n))
    case False{}:
      w.rot.small(x, n)

def w.rotr(+x: W, +n: Nat) -> W:
  w.rotr.at(Nat.is_le(32n, n), x, n)

def w.shr(+x: W, +n: Nat) -> W:
  match x:
    case W{+xh, +xl}:
      W{U32.shrn(xh, n), U32.or(U32.shrn(xl, n), U32.shln(xh, Nat.sub(32n, n)))}

# the sigma and Sigma functions (FIPS 180-4 4.1.3) and the choice and majority
def w.S0(+x: W) -> W:
  w.xor(w.xor(w.rotr(x, 28n), w.rotr(x, 34n)), w.rotr(x, 39n))

def w.S1(+x: W) -> W:
  w.xor(w.xor(w.rotr(x, 14n), w.rotr(x, 18n)), w.rotr(x, 41n))

def w.s0(+x: W) -> W:
  w.xor(w.xor(w.rotr(x, 1n), w.rotr(x, 8n)), w.shr(x, 7n))

def w.s1(+x: W) -> W:
  w.xor(w.xor(w.rotr(x, 19n), w.rotr(x, 61n)), w.shr(x, 6n))

def w.ch(+x: W, +y: W, +z: W) -> W:
  w.xor(w.and(x, y), w.and(w.not(x), z))

def w.maj(+x: W, +y: W, +z: W) -> W:
  w.xor(w.xor(w.and(x, y), w.and(x, z)), w.and(y, z))

# the big-endian 32-bit value of 4 bytes at the front of xs, and of 8 bytes as a word
def sha512.be32(+a: U32, +b: U32, +c: U32, +d: U32) -> U32:
  U32.or(U32.or(U32.shln(a, 24n), U32.shln(b, 16n)), U32.or(U32.shln(c, 8n), d))

def sha512.head(+xs: List<&2, U32>) -> U32:
  match xs:
    case Nil{}:
      0
    case x <> t:
      x

# the 16 message words of a 128-byte block
def sha512.at(+xs: List<&2, U32>, i: Nat) -> U32:
  sha512.head(List.drop(&2, U32, xs, i))

def sha512.word.at(+xs: List<&2, U32>) -> W:
  W{sha512.be32(sha512.at(xs, 0n), sha512.at(xs, 1n), sha512.at(xs, 2n), sha512.at(xs, 3n)),
    sha512.be32(sha512.at(xs, 4n), sha512.at(xs, 5n), sha512.at(xs, 6n), sha512.at(xs, 7n))}

def sha512.word(+bs: List<&2, U32>, i: Nat) -> W:
  sha512.word.at(List.take(&2, U32, List.drop(&2, U32, bs, Nat.mul(8n, i)), 8n))

def sha512.block(+bs: List<&2, U32>) -> WIN:
  WIN{sha512.word(bs, 0n), sha512.word(bs, 1n), sha512.word(bs, 2n), sha512.word(bs, 3n),
    sha512.word(bs, 4n), sha512.word(bs, 5n), sha512.word(bs, 6n), sha512.word(bs, 7n),
    sha512.word(bs, 8n), sha512.word(bs, 9n), sha512.word(bs, 10n), sha512.word(bs, 11n),
    sha512.word(bs, 12n), sha512.word(bs, 13n), sha512.word(bs, 14n), sha512.word(bs, 15n)}

def sha512.win.list(+win: WIN) -> List<&2, W>:
  match win:
    case WIN{+w0, +w1, +w2, +w3, +w4, +w5, +w6, +w7, +w8, +w9, +w10, +w11, +w12, +w13, +w14, +w15}:
      w0 <> w1 <> w2 <> w3 <> w4 <> w5 <> w6 <> w7 <> w8 <> w9 <> w10 <> w11 <> w12 <> w13 <> w14 <> w15 <> Nil{}

# W[t] = s1(W[t-2]) + W[t-7] + s0(W[t-15]) + W[t-16], from the window
def sha512.sched.next(+win: WIN) -> W:
  match win:
    case WIN{+w0, +w1, +w2, +w3, +w4, +w5, +w6, +w7, +w8, +w9, +w10, +w11, +w12, +w13, +w14, +w15}:
      w.add(w.add(w.s1(w14), w9), w.add(w.s0(w1), w0))

def sha512.sched.shift(+win: WIN, +nw: W) -> WIN:
  match win:
    case WIN{+w0, +w1, +w2, +w3, +w4, +w5, +w6, +w7, +w8, +w9, +w10, +w11, +w12, +w13, +w14, +w15}:
      WIN{w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, nw}

# the next fuel words of the schedule
def sha512.sched(fuel: Nat, +win: WIN) -> List<&2, W>:
  match fuel:
    case 0n:
      Nil{}
    case 1n+p:
      +nw : W = sha512.sched.next(win)
      nw <> sha512.sched(p, sha512.sched.shift(win, nw))

# one round with the round constant k and the schedule word wt
def sha512.round.at(+a: W, +b: W, +c: W, +d: W, +e: W, +f: W, +g: W, +h: W, +k: W, +wt: W) -> ST:
  +t1 : W = w.add(w.add(w.add(h, w.S1(e)), w.add(w.ch(e, f, g), k)), wt)
  +t2 : W = w.add(w.S0(a), w.maj(a, b, c))
  ST{w.add(t1, t2), a, b, c, w.add(d, t1), e, f, g}

# the rounds over the constants and the schedule
def sha512.round(+st: ST, +k: W, +wt: W) -> ST:
  match st:
    case ST{+a, +b, +c, +d, +e, +f, +g, +h}:
      sha512.round.at(a, b, c, d, e, f, g, h, k, wt)

def sha512.rounds(ks: List<&2, W>, ws: List<&2, W>, +st: ST) -> ST:
  match ks ws:
    case Nil{} _:
      st
    case _ Nil{}:
      st
    case k <> kt w <> wt:
      sha512.rounds(kt, wt, sha512.round(st, k, w))

# the compression of one 128-byte block into the state
def sha512.add.state(+x: ST, +y: ST) -> ST:
  match x:
    case ST{+a1, +b1, +c1, +d1, +e1, +f1, +g1, +h1}:
      match y:
        case ST{+a2, +b2, +c2, +d2, +e2, +f2, +g2, +h2}:
          ST{w.add(a1, a2), w.add(b1, b2), w.add(c1, c2), w.add(d1, d2),
            w.add(e1, e2), w.add(f1, f2), w.add(g1, g2), w.add(h1, h2)}

# the compression of fuel blocks of bs
def sha512.compress.at(+st: ST, +win: WIN) -> ST:
  sha512.add.state(st, sha512.rounds(sha512.K(), List.append(&2, W, sha512.win.list(win), sha512.sched(64n, win)), st))

def sha512.compress(+st: ST, +bs: List<&2, U32>) -> ST:
  sha512.compress.at(st, sha512.block(bs))

def sha512.blocks(fuel: Nat, +st: ST, +bs: List<&2, U32>) -> ST:
  match fuel:
    case 0n:
      st
    case 1n+p:
      sha512.blocks(p, sha512.compress(st, List.take(&2, U32, bs, 128n)), List.drop(&2, U32, bs, 128n))

# Padding and output
# ------------------

def sha512.cat(+xs: List<&2, U32>, +ys: List<&2, U32>) -> List<&2, U32>:
  List.append(&2, U32, xs, ys)

def sha512.zeros(n: Nat) -> List<&2, U32>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      0 <> sha512.zeros(p)

# the zero bytes after the 0x80 byte: the total becomes 112 mod 128 before the length
def sha512.pad.zeros(n: Nat) -> Nat:
  Nat.mod(Nat.sub(240n, Nat.mod(Nat.add(n, 1n), 128n)), 128n)

# the message, 0x80, zeros, then the length in bits as 16 bytes (big-endian)
def sha512.be32list(+w: U32) -> List<&2, U32>:
  U32.and(U32.shrn(w, 24n), 255) <> U32.and(U32.shrn(w, 16n), 255)
    <> U32.and(U32.shrn(w, 8n), 255) <> U32.and(w, 255) <> Nil{}

def sha512.bitlen(n: Nat) -> List<&2, U32>:
  sha512.cat(sha512.zeros(4n), sha512.be32list(U32.from_nat(Nat.mul(8n, n))))

def sha512.pad(+msg: List<&2, U32>) -> List<&2, U32>:
  sha512.cat(msg, sha512.cat(128 <> sha512.zeros(sha512.pad.zeros(List.length(&2, U32, msg))),
    sha512.cat(sha512.zeros(8n), sha512.bitlen(List.length(&2, U32, msg)))))

# the length of n bytes in bits, as 8 big-endian bytes (n < 2^29)
def sha512.wbytes(+x: W) -> List<&2, U32>:
  match x:
    case W{+h, +l}:
      sha512.cat(sha512.be32list(h), sha512.be32list(l))

# SHA-512 of the message: 64 bytes
def sha512.out(+st: ST) -> List<&2, U32>:
  match st:
    case ST{+a, +b, +c, +d, +e, +f, +g, +h}:
      sha512.cat(sha512.wbytes(a), sha512.cat(sha512.wbytes(b), sha512.cat(sha512.wbytes(c),
        sha512.cat(sha512.wbytes(d), sha512.cat(sha512.wbytes(e), sha512.cat(sha512.wbytes(f),
        sha512.cat(sha512.wbytes(g), sha512.wbytes(h))))))))

def sha512.hash.at(+padded: List<&2, U32>) -> List<&2, U32>:
  sha512.out(sha512.blocks(Nat.div(List.length(&2, U32, padded), 128n), sha512.IV(), padded))

# SHA-384: the same compression from its own initial value, the first 48 bytes out
def sha512.hash(+msg: List<&2, U32>) -> List<&2, U32>:
  sha512.hash.at(sha512.pad(msg))

def sha384.hash.at(+padded: List<&2, U32>) -> List<&2, U32>:
  sha512.out(sha512.blocks(Nat.div(List.length(&2, U32, padded), 128n), sha512.IV384(), padded))

def sha384.hash(+msg: List<&2, U32>) -> List<&2, U32>:
  List.take(&2, U32, sha384.hash.at(sha512.pad(msg)), 48n)
