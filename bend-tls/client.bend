# client.bend: a TLS 1.3 client (TLS_CHACHA20_POLY1305_SHA256 over x25519) that
# checks the server's certificate chain against a trust anchor and fetches GET /.
#
#   bend gen_client.py && bend client.bend -o client
#   ./client <server-name> <ip> <port> <anchor.der> <unix-time>
#
# <server-name> goes in the ClientHello and must match the certificate; <ip> is
# where the socket connects (the TCP kit has no DNS). Bend has no wall clock, so
# the current Unix time is an argument. client.bend is generated by gen_client.py:
# its socket readers are chains of numbered stages, because Bend's checker takes
# no recursion through IO.

import Base
import ./sha256.bend as S
import ./hkdf.bend as K
import ./x25519.bend as X
import ./p256.bend as P
import ./p384.bend as Q
import ./tls.bend as T
import ./handshake.bend as H
import ./x509.bend as C

# Randomness
# ----------

# the 4 little-endian bytes of w, in front of acc
def io.le(+w: U32, acc: List<&2, U32>) -> List<&2, U32>:
  U32.and(w, 255) <> U32.and(U32.shrn(w, 8n), 255) <> U32.and(U32.shrn(w, 16n), 255)
    <> U32.and(U32.shrn(w, 24n), 255) <> acc

# k random bytes, from IO.random_u32 (4 bytes each; k a multiple of 4)
def io.rand(k: Nat) -> IO(List<&2, U32>):
  match k:
    case 0n:
      IO.pure(List<&2, U32>, Nil{})
    case 1n+p:
      do IO<List<&2, U32>>:
        w : U32 <- IO.try(U32, IO.random_u32())
        rest : List<&2, U32> <- io.rand(p)
        return io.le(w, rest)

# Socket bytes
# ------------

# the next record, whole, with the bytes after it and the socket
def io.r48.at(ok: Bool, s: Socket, +buf: List<&2, U32>, +need: Nat) -> IO(Socket & List<&2, U32>):
  match ok:
    case True{}:
      IO.pure(Socket & List<&2, U32>, (s, buf))
    case False{}:
      do IO<Socket & List<&2, U32>>:
        Socket.close(s)
        IO.die(Socket & List<&2, U32>, 1, "a record was not complete after 48 reads")


# The state of a read: bytes not yet read, handshake (or app) bytes so far,
# the server's record sequence number, and whether a record failed to open
# ---------------------------------------------------------------------------

# recs holds the bodies of the records read so far, newest first: adding one is O(1),
# and the flat bytes (fl.acc) are built once when they are needed
def io.r48.got(m: Socket & Result<&1, &1, U32 & String, Maybe<&1, List<&2, U32>>>, +buf: List<&2, U32>,
  +need: Nat) -> IO(Socket & List<&2, U32>):
  (s, r) = m
  match r:
    case Fail{(code, message)}:
      IO.pure(Socket & List<&2, U32>, (s, buf))
    case Done{None{}}:
      IO.pure(Socket & List<&2, U32>, (s, buf))
    case Done{Some{+chunk}}:
      io.r48.at(Nat.is_le(need, List.length(&2, U32, List.append(&2, U32, buf, chunk))), s,
        List.append(&2, U32, buf, chunk), need)

# bytes until buf holds need bytes (or the peer closes): the stage chain's entry
def io.r47.at(ok: Bool, s: Socket, +buf: List<&2, U32>, +need: Nat) -> IO(Socket & List<&2, U32>):
  match ok:
    case True{}:
      IO.pure(Socket & List<&2, U32>, (s, buf))
    case False{}:
      do IO<Socket & List<&2, U32>>:
        r : Socket & Result<&1, &1, U32 & String, Maybe<&1, List<&2, U32>>> <- TCP.recv_bytes(s, 16384)
        io.r48.got(r, buf, need)

