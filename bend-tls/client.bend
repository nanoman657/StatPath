        io.r1.got(r, buf, need)

def io.fill(s: Socket, +buf: List<&2, U32>, +need: Nat) -> IO(Socket & List<&2, U32>):
  io.r0.at(Nat.is_le(need, List.length(&2, U32, buf)), s, buf, need)

# the fill chain ends at io.rK: a record that is still not whole after K reads is an error
def io.record.cut(s: Socket, +b: List<&2, U32>, +n: Nat) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  IO.pure(Socket & List<&2, U32> & List<&2, U32>, (s, (List.drop(&2, U32, b, n), List.take(&2, U32, b, n))))

# sending: the whole data, or the program stops with the peer's error
def io.record.done.at(ok: Bool, s: Socket, +b: List<&2, U32>, +n: Nat) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  match ok:
    case True{}:
      io.record.cut(s, b, n)
    case False{}:
      do IO<Socket & List<&2, U32> & List<&2, U32>>:
        Socket.close(s)
        IO.die(Socket & List<&2, U32> & List<&2, U32>, 1, "the connection closed inside a record")

def io.record.done.split(s: Socket, +b: List<&2, U32>, +n: Nat) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  io.record.done.at(Bool.or(Nat.is_eq(List.length(&2, U32, b), 0n), Nat.is_le(n, List.length(&2, U32, b))), s, b, n)

def io.record.done(r: Socket & List<&2, U32>, +n: Nat) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  (s, b) = r
  io.record.done.split(s, b, n)

def io.record.need(s: Socket, +b: List<&2, U32>) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  do IO<Socket & List<&2, U32> & List<&2, U32>>:
    r : Socket & List<&2, U32> <- io.fill(s, b, Nat.add(5n, T.tls.num(2n, List.drop(&2, U32, b, 3n))))
    io.record.done(r, Nat.add(5n, T.tls.num(2n, List.drop(&2, U32, b, 3n))))

# the first n bytes of the buffer (the record) and the rest after them. A connection
# that closes inside a record is an error; closing at a record boundary (an empty
# buffer) is the end of the stream
def io.record.body(h: Socket & List<&2, U32>) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  (s, b) = h
  io.record.need(s, b)

# the record whose header starts b: fill up to its length, then cut it off
def io.record(s: Socket, buf: List<&2, U32>) -> IO(Socket & List<&2, U32> & List<&2, U32>):
  do IO<Socket & List<&2, U32> & List<&2, U32>>:
    h : Socket & List<&2, U32> <- io.fill(s, buf, 5n)
    io.record.body(h)

def io.send.done(m: Socket & Result<&1, &1, (U32 & String) & List<&2, U32>, Unit>) -> IO(Socket):
  (s, r) = m
  match r:
    case Fail{((code, message), rest)}:
      do IO<Socket>:
        Socket.close(s)
        IO.die(Socket, code, message)
    case Done{u}:
      IO.pure(Socket, s)

def io.send(s: Socket, +data: List<&2, U32>) -> IO(Socket):
  do IO<Socket>:
    sent : Socket & Result<&1, &1, (U32 & String) & List<&2, U32>, Unit> <- TCP.send_bytes(s, data)
    io.send.done(sent)

# stops the program, closing the socket first
def io.fail(s: Socket, msg: String) -> IO(Unit):
  do IO<Unit>:
    Socket.close(s)
    IO.die(Unit, 1, msg)

type Fl is Data:
  Fl{buf: List<&2, U32>, recs: List<&2, List<&2, U32>>, seq: Nat, bad: Bool}

def fl.buf(+st: Fl) -> List<&2, U32>:
  match st:
    case Fl{+buf, +acc, +seq, +bad}:
      buf

# the record bodies, newest first
def fl.recs(+st: Fl) -> List<&2, List<&2, U32>>:
  match st:
    case Fl{+buf, +recs, +seq, +bad}:
      recs

# the bytes of all the records, oldest first
def fl.flat(+rs: List<&2, List<&2, U32>>) -> List<&2, U32>:
  match rs:
    case Nil{}:
      Nil{}
    case x <> t:
      List.append(&2, U32, x, fl.flat(t))

def fl.acc(+st: Fl) -> List<&2, U32>:
  fl.flat(List.reverse(&2, List<&2, U32>, fl.recs(st)))

# the bodies in order, each appended to the rest (the recursion is over one body)
def fl.seq(+st: Fl) -> Nat:
  match st:
    case Fl{+buf, +acc, +seq, +bad}:
      seq

def fl.bad(+st: Fl) -> Bool:
  match st:
    case Fl{+buf, +acc, +seq, +bad}:
      bad

# one record (header and body) read at the state st: a ChangeCipherSpec record
# (header type 20) is skipped; any other record is opened under key and iv, and
# its content joins the state when its content type is want
def fl.take(take: Bool, +body: List<&2, U32>, +st: Fl, +rest: List<&2, U32>) -> Fl:
  match take:
    case True{}:
      Fl{rest, body <> fl.recs(st), Nat.add(fl.seq(st), 1n), fl.bad(st)}
    case False{}:
      Fl{rest, fl.recs(st), Nat.add(fl.seq(st), 1n), fl.bad(st)}

# Handshake messages
# ------------------

# the length of the handshake message at the front of acc (4-byte header included)
def fl.add(alert: Bool, take: Bool, +body: List<&2, U32>, +st: Fl, +rest: List<&2, U32>) -> Fl:
  match alert:
    case True{}:
      Fl{rest, fl.recs(st), Nat.add(fl.seq(st), 1n), True{}}
    case False{}:
      fl.take(take, body, st, rest)

def fl.inner(+inn: H.Inner, +st: Fl, +rest: List<&2, U32>, want: U32) -> Fl:
  match inn:
    case H.Inner{ctype, body}:
      fl.add(U32.is_eq(ctype, 21), U32.is_eq(ctype, want), body, st, rest)

def fl.open(opened: Maybe<&2, List<&2, U32>>, +st: Fl, +rest: List<&2, U32>, want: U32) -> Fl:
  match opened:
    case Some{pt}:
      fl.inner(H.hs.unpad(pt), st, rest, want)
    case None{}:
      Fl{rest, fl.recs(st), fl.seq(st), True{}}

# an alert (content type 21) ends the stream: a peer's close_notify, or an error
def fl.next.at(hdr: U32, +st: Fl, +rest: List<&2, U32>, +rec: List<&2, U32>,
  +key: List<&2, U32>, +iv: List<&2, U32>, want: U32) -> Fl:
  match hdr:
    case 20:
      Fl{rest, fl.recs(st), fl.seq(st), fl.bad(st)}
    case _:
      fl.open(H.hs.open(key, iv, fl.seq(st), rec), st, rest, want)

def fl.next(+st: Fl, +rest: List<&2, U32>, +rec: List<&2, U32>, +key: List<&2, U32>,
  +iv: List<&2, U32>, want: U32) -> Fl:
  fl.next.at(T.tls.tag(rec), st, rest, rec, key, iv, want)

def flight.msglen(+acc: List<&2, U32>) -> Nat:
  Nat.add(4n, T.tls.num(3n, List.drop(&2, U32, acc, 1n)))

# the offsets of the messages after the first: Certificate, CertificateVerify, Finished
def flight.off3(+acc: List<&2, U32>) -> Nat:
  Nat.add(flight.msglen(acc), flight.msglen(List.drop(&2, U32, acc, flight.msglen(acc))))

def flight.off4(+acc: List<&2, U32>) -> Nat:
  Nat.add(flight.off3(acc), flight.msglen(List.drop(&2, U32, acc, flight.off3(acc))))

def flight.off5(+acc: List<&2, U32>) -> Nat:
  Nat.add(flight.off4(acc), flight.msglen(List.drop(&2, U32, acc, flight.off4(acc))))

# the body of the message that starts at from (its 4-byte header is skipped)
def flight.msg(+acc: List<&2, U32>, +from: Nat) -> List<&2, U32>:
  List.take(&2, U32, List.drop(&2, U32, acc, Nat.add(from, 4n)),
    Nat.sub(flight.msglen(List.drop(&2, U32, acc, from)), 4n))

# the flight is EncryptedExtensions, Certificate, CertificateVerify, Finished
def flight.kinds(+acc: List<&2, U32>) -> Bool:
  Bool.and(U32.is_eq(T.tls.tag(acc), 8),
    Bool.and(U32.is_eq(T.tls.tag(List.drop(&2, U32, acc, flight.msglen(acc))), 11),
      Bool.and(U32.is_eq(T.tls.tag(List.drop(&2, U32, acc, flight.off3(acc))), 15),
        U32.is_eq(T.tls.tag(List.drop(&2, U32, acc, flight.off4(acc))), 20))))

# the transcript hash of ClientHello, ServerHello and the first n bytes of the flight
def flight.th(+acc: List<&2, U32>, +ch: List<&2, U32>, +sh: List<&2, U32>, +n: Nat) -> List<&2, U32>:
  S.sha256_bytes(T.tls.cat(ch, T.tls.cat(sh, List.take(&2, U32, acc, n))))

# the leaf is the first certificate of the chain
def flight.leaf(+chain: List<&2, List<&2, U32>>) -> List<&2, U32>:
  match chain:
    case Nil{}:
      Nil{}
    case +leaf <> more:
      leaf

def flight.second(+chain: List<&2, List<&2, U32>>) -> List<&2, U32>:
  match chain:
    case Nil{}:
      Nil{}
    case +x <> rest:
      flight.leaf(rest)

def flight.chain_ok(+chain: List<&2, List<&2, U32>>, +der: List<&2, U32>, +host: List<&2, U32>,
  +now: Nat) -> Bool:
  C.x509.verify_server(chain, der <> Nil{}, host, now)

def flight.verify.at(kinds: Bool, chain: Bool, cv: Bool, fin: Bool) -> Bool:
  Bool.and(kinds, Bool.and(chain, Bool.and(cv, fin)))

# the server's flight: its kinds, its chain (against the anchor at now and for
# host), its CertificateVerify over the transcript through Certificate, and its
# Finished over the transcript through CertificateVerify
def flight.verify(+acc: List<&2, U32>, +ch: List<&2, U32>, +sh: List<&2, U32>, +s_hs: List<&2, U32>,
  +der: List<&2, U32>, +now: Nat, +host: List<&2, U32>) -> Bool:
  flight.verify.at(flight.kinds(acc),
    flight.chain_ok(T.tls.certs(flight.msg(acc, flight.msglen(acc))), der, host, now),
    H.hs.cv_ok(flight.leaf(T.tls.certs(flight.msg(acc, flight.msglen(acc)))),
      flight.th(acc, ch, sh, flight.off3(acc)), flight.msg(acc, flight.off3(acc))),
    H.hs.fin_ok(s_hs, flight.th(acc, ch, sh, flight.off4(acc)), flight.msg(acc, flight.off4(acc))))

# true once a complete Finished message is among the messages of acc
def flight.complete(+acc: List<&2, U32>) -> Bool:
  Nat.is_le(flight.msglen(acc), List.length(&2, U32, acc))

def flight.fin(+acc: List<&2, U32>) -> Bool:
  U32.is_eq(T.tls.tag(acc), 20)

def flight.scan(fuel: Nat, +acc: List<&2, U32>, fin: Bool, complete: Bool) -> Bool:
  match fuel:
    case 0n:
      False{}
    case 1n+p:
      match fin complete:
        case True{} True{}:
          True{}
        case True{} False{}:
          False{}
        case False{} False{}:
          False{}
        case False{} True{}:
          flight.scan(p, List.drop(&2, U32, acc, flight.msglen(acc)),
            flight.fin(List.drop(&2, U32, acc, flight.msglen(acc))),
            flight.complete(List.drop(&2, U32, acc, flight.msglen(acc))))

# the flight is over when the state is bad or a Finished is complete (a bad
# state with no Finished is an error, reported after the flight)
def flight.done(+acc: List<&2, U32>) -> Bool:
  flight.scan(1000000n, acc, flight.fin(acc), flight.complete(acc))

def flight.stop(bad: Bool, done: Bool) -> Bool:
  match bad:
    case True{}:
      True{}
    case False{}:
      done

def flight.good(bad: Bool, done: Bool) -> Bool:
  match bad:
    case True{}:
      False{}
    case False{}:
      done

# the flight stages: stage k reads one record while the flight is open (every
# stage calls only the next one)
def f24.at(+done: Bool, s: Socket, +st: Fl, +key: List<&2, U32>, +iv: List<&2, U32>) -> IO(Socket & Fl):
  IO.pure(Socket & Fl, (s, st))



# ServerHello
# -----------

# the server's message in the record (its raw bytes, its key share and its group),
# and the record key length of its suite
def f23.next(s: Socket, +st: Fl, +key: List<&2, U32>, +iv: List<&2, U32>) -> IO(Socket & Fl):
  f24.at(flight.stop(fl.bad(st), flight.done(fl.acc(st))), s, st, key, iv)

def f23.got(t: Socket & List<&2, U32> & List<&2, U32>, +st: Fl, +key: List<&2, U32>, +iv: List<&2, U32>) -> IO(Socket & Fl):
  (s, pr) = t
  (rest, rec) = pr
  f23.next(s, fl.next(st, rest, rec, key, iv, 22), key, iv)

def f23.at(done: Bool, s: Socket, +st: Fl, +key: List<&2, U32>, +iv: List<&2, U32>) -> IO(Socket & Fl):
  match done:
    case True{}:
      IO.pure(Socket & Fl, (s, st))
    case False{}:
      do IO<Socket & Fl>:
        t : Socket & List<&2, U32> & List<&2, U32> <- io.record(s, fl.buf(st))
        f23.got(t, st, key, iv)

