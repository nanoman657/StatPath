def aes.sbox(+x: U32) -> U32:
  aes.sbpk(U32.is_lt(x, 128), x)

def aes.head(+xs: List<&2, U32>) -> U32:
  match xs:
    case Nil{}:
      0
    case x <> t:
      x

# the byte at index i of xs
def aes.at(+xs: List<&2, U32>, i: Nat) -> U32:
  aes.head(List.drop(&2, U32, xs, i))

# the 4 bytes of word k of xs (k counts 4-byte words)
def aes.word(+xs: List<&2, U32>, k: Nat) -> List<&2, U32>:
  List.take(&2, U32, List.drop(&2, U32, xs, Nat.mul(4n, k)), 4n)

# SubBytes: each byte through the S-box
def aes.sub(+s: List<&2, U32>) -> List<&2, U32>:
  match s:
    case Nil{}:
      Nil{}
    case x <> t:
      aes.sbox(x) <> aes.sub(t)

# ShiftRows: row r moves left by r (new byte 4c + r is old byte 4((c + r) mod 4) + r)
def aes.shift(+s: List<&2, U32>) -> List<&2, U32>:
  aes.at(s, 0n) <> aes.at(s, 5n) <> aes.at(s, 10n) <> aes.at(s, 15n)
    <> aes.at(s, 4n) <> aes.at(s, 9n) <> aes.at(s, 14n) <> aes.at(s, 3n)
    <> aes.at(s, 8n) <> aes.at(s, 13n) <> aes.at(s, 2n) <> aes.at(s, 7n)
    <> aes.at(s, 12n) <> aes.at(s, 1n) <> aes.at(s, 6n) <> aes.at(s, 11n) <> Nil{}

# multiplication by x (0x02) in GF(2^8), with the reduction by 0x11b
def aes.xtime(+x: U32) -> U32:
  U32.xor(U32.and(U32.shln(x, 1n), 255), Bool.pick(U32, U32.is_ge(x, 128), 27, 0))

# multiplication by 3 (0x02 ^ 1)
def aes.mul3(+x: U32) -> U32:
  U32.xor(aes.xtime(x), x)

# MixColumns on one column (FIPS 197 5.1.3)
def aes.mix.col(+a0: U32, +a1: U32, +a2: U32, +a3: U32) -> List<&2, U32>:
  U32.xor(U32.xor(aes.xtime(a0), aes.mul3(a1)), U32.xor(a2, a3))
    <> U32.xor(U32.xor(a0, aes.xtime(a1)), U32.xor(aes.mul3(a2), a3))
    <> U32.xor(U32.xor(a0, a1), U32.xor(aes.xtime(a2), aes.mul3(a3)))
    <> U32.xor(U32.xor(aes.mul3(a0), a1), U32.xor(a2, aes.xtime(a3))) <> Nil{}

# MixColumns on each column of the state
def aes.mix(+s: List<&2, U32>) -> List<&2, U32>:
  match s:
    case a0 <> (a1 <> (a2 <> (a3 <> t))):
      List.append(&2, U32, aes.mix.col(a0, a1, a2, a3), aes.mix(t))
    case _:
      Nil{}

# AddRoundKey: byte-wise xor of the state and a round key of the same length
def aes.xor(+s: List<&2, U32>, +k: List<&2, U32>) -> List<&2, U32>:
  match s k:
    case Nil{} _:
      Nil{}
    case _ Nil{}:
      Nil{}
    case x <> t y <> u:
      U32.xor(x, y) <> aes.xor(t, u)

# the next round key from the previous one (FIPS 197 5.2): the last word is
# rotated, substituted and xored with the round constant, then each word is
# xored with the one before it
def aes.next(+prev: List<&2, U32>, rcon: U32) -> List<&2, U32>:
  +rot : List<&2, U32> = aes.at(aes.word(prev, 3n), 1n) <> aes.at(aes.word(prev, 3n), 2n)
    <> aes.at(aes.word(prev, 3n), 3n) <> aes.at(aes.word(prev, 3n), 0n) <> Nil{}
  +t : List<&2, U32> = aes.xor(aes.sub(rot), rcon <> 0 <> 0 <> 0 <> Nil{})
  +w0 : List<&2, U32> = aes.xor(aes.word(prev, 0n), t)
  +w1 : List<&2, U32> = aes.xor(aes.word(prev, 1n), w0)
  +w2 : List<&2, U32> = aes.xor(aes.word(prev, 2n), w1)
  +w3 : List<&2, U32> = aes.xor(aes.word(prev, 3n), w2)
  List.append(&2, U32, w0, List.append(&2, U32, w1, List.append(&2, U32, w2, w3)))

# the round keys of a 16-byte key: out holds the keys so far, prev is the last
def aes.keys(fuel: Nat, +rcon: U32, +prev: List<&2, U32>, +out: List<&2, U32>) -> List<&2, U32>:
  match fuel:
    case 0n:
      out
    case 1n+p:
      +nk : List<&2, U32> = aes.next(prev, rcon)
      aes.keys(p, aes.xtime(rcon), nk, List.append(&2, U32, out, nk))

# the 176 bytes of the 11 round keys of a 16-byte key (FIPS 197 5.2)
def aes.expand(+key: List<&2, U32>) -> List<&2, U32>:
  aes.keys(10n, 1, key, key)

# the rounds 1..9: SubBytes, ShiftRows, MixColumns, AddRoundKey
def aes.final(+s: List<&2, U32>, +rk: List<&2, U32>) -> List<&2, U32>:
  aes.xor(aes.shift(aes.sub(s)), List.take(&2, U32, rk, 16n))

# the encryption of one 16-byte block under the 176-byte round keys rk
def aes.main(fuel: Nat, +s: List<&2, U32>, +rk: List<&2, U32>) -> List<&2, U32>:
  match fuel:
    case 0n:
      aes.final(s, rk)
    case 1n+p:
      aes.main(p, aes.xor(aes.mix(aes.shift(aes.sub(s))), List.take(&2, U32, rk, 16n)),
        List.drop(&2, U32, rk, 16n))

# the last round: no MixColumns
def aes.enc(+rk: List<&2, U32>, +blk: List<&2, U32>) -> List<&2, U32>:
  aes.main(9n, aes.xor(blk, List.take(&2, U32, rk, 16n)), List.drop(&2, U32, rk, 16n))
