type Case is Data:
  Case{name: String, got: String, want: String}

def kcase(name: String, +got: String, want: String) -> Case:
  Case{name, got, want}

def is_some(+m: Maybe<&2, List<&2, U32>>) -> Bool:
  match m:
    case Some{+p}:
      True{}
    case None{}:
      False{}

def body_of(+m: T.HM) -> List<&2, U32>:
  match m:
    case T.HM{+t, +b, +r}:
      b

