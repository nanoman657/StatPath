# bigint_tests.bend: Montgomery products against Python integers
# (generated by gen_bigint_tests.py). The expected value is the limb list.
#   bend bigint_tests.bend

import Base
import ./bigint.bend as B

type Case is Data:
  Case{name: String, got: String, want: String}

def kcase(name: String, +got: String, want: String) -> Case:
  Case{name, got, want}

# the limbs as text, least significant first, each followed by a comma
def limbs_text(xs: List<&2, Nat>, acc: String) -> String:
  match xs:
    case Nil{}:
      acc
    case x <> t:
      limbs_text(t, acc ++ Nat.show(x) ++ ",")

def cases() -> List<&2, Case>:
  kcase("mont-n1-0", limbs_text(B.bi.mont([30750n, 0n, 0n], [31488n, 0n, 0n], [56461n, 0n, 0n], 47547n, 1n), ""), "39035,0,0,") <>
  kcase("mont-n1-1", limbs_text(B.bi.mont([27325n, 0n, 0n], [14853n, 0n, 0n], [51443n, 0n, 0n], 28613n, 1n), ""), "8244,0,0,") <>
  kcase("mont-n2-0", limbs_text(B.bi.mont([40678n, 383n, 0n, 0n], [1492n, 26838n, 0n, 0n], [53407n, 62046n, 0n, 0n], 46241n, 2n), ""), "38693,16690,0,0,") <>
  kcase("mont-n2-1", limbs_text(B.bi.mont([26806n, 43103n, 0n, 0n], [12550n, 46596n, 0n, 0n], [45735n, 55976n, 0n, 0n], 10985n, 2n), ""), "3891,31263,0,0,") <>
  kcase("mont-n4-0", limbs_text(B.bi.mont([6104n, 41615n, 11666n, 14577n, 0n, 0n], [50661n, 663n, 52739n, 19437n, 0n, 0n], [22711n, 16964n, 20007n, 48356n, 0n, 0n], 64249n, 4n), ""), "3204,45886,58364,30787,0,0,") <>
  kcase("mont-n4-1", limbs_text(B.bi.mont([46635n, 21958n, 54968n, 43693n, 0n, 0n], [25956n, 48720n, 48887n, 39459n, 0n, 0n], [48227n, 19794n, 1170n, 53406n, 0n, 0n], 23221n, 4n), ""), "43034,10742,25466,10851,0,0,") <>
  kcase("mont-n8-0", limbs_text(B.bi.mont([55909n, 62665n, 35761n, 39504n, 50462n, 16613n, 12020n, 1335n, 0n, 0n], [5476n, 58559n, 59687n, 10089n, 18798n, 52929n, 63519n, 39717n, 0n, 0n], [16681n, 20323n, 46076n, 1453n, 50028n, 51723n, 59097n, 47208n, 0n, 0n], 5351n, 8n), ""), "49861,57806,15039,64840,34961,9216,41074,40321,0,0,") <>
  kcase("mont-n8-1", limbs_text(B.bi.mont([5247n, 29936n, 38311n, 39235n, 39715n, 41074n, 22121n, 46107n, 0n, 0n], [29104n, 19413n, 8847n, 64581n, 3413n, 14702n, 55181n, 51291n, 0n, 0n], [63539n, 43739n, 21766n, 41350n, 44418n, 1793n, 31332n, 63224n, 0n, 0n], 15621n, 8n), ""), "18430,18328,31559,23028,53761,59179,27086,52433,0,0,") <>
  kcase("mont-n16-0", limbs_text(B.bi.mont([52882n, 27729n, 18600n, 33865n, 7394n, 42141n, 39891n, 11289n, 17286n, 62153n, 30633n, 36873n, 32082n, 19203n, 21052n, 37929n, 0n, 0n], [1119n, 2884n, 32889n, 18533n, 31879n, 63824n, 9424n, 5479n, 22587n, 54563n, 13366n, 65532n, 9553n, 51795n, 8289n, 405n, 0n, 0n], [26855n, 20302n, 51382n, 23709n, 45347n, 16923n, 36221n, 27543n, 59855n, 51630n, 12618n, 5632n, 9553n, 22792n, 63768n, 65161n, 0n, 0n], 54569n, 16n), ""), "25832,11346,48936,28120,59239,50809,34731,28912,44679,29821,61345,33852,31240,41963,24325,19051,0,0,") <>
  kcase("mont-n16-1", limbs_text(B.bi.mont([47608n, 31134n, 42761n, 45809n, 33055n, 52149n, 65284n, 8056n, 52647n, 29770n, 59927n, 54588n, 23477n, 40175n, 57661n, 5121n, 0n, 0n], [53143n, 26621n, 31201n, 58770n, 6371n, 24199n, 28725n, 2164n, 19131n, 35338n, 63908n, 2817n, 14985n, 43212n, 21177n, 42609n, 0n, 0n], [49241n, 34299n, 25502n, 24449n, 57552n, 15387n, 13241n, 32105n, 60841n, 10125n, 24928n, 20242n, 35866n, 19938n, 7107n, 53504n, 0n, 0n], 30743n, 16n), ""), "44775,22203,9545,39221,53742,36593,34779,2449,63515,36809,27882,54054,26343,55809,15492,7373,0,0,") <>
  Nil{}

def fails.at(+c: Case, +rest: List<&2, String>) -> List<&2, String>:
  match c:
    case Case{n, +g, +w}:
      Bool.pick(List<&2, String>, String.eq(g, w), rest,
        ("FAIL " ++ n ++ "\n  got:  " ++ g ++ "\n  want: " ++ w) <> rest)

def fails(cs: List<&2, Case>) -> List<&2, String>:
  match cs:
    case Nil{}:
      Nil{}
    case +c <> t:
      fails.at(c, fails(t))

def main() -> IO(Unit):
  +cs = cases()
  +n = List.length(&2, Case, cs)
  +fs = fails(cs)
  +f = List.length(&2, String, fs)
  do IO<Unit>:
    List.for_each(~&2, ~String, ~IO.print, fs)
    IO.print("bigint: " ++ Nat.show(Nat.sub(n, f)) ++ " passed, " ++ Nat.show(f) ++ " failed")
