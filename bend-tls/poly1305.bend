# poly1305.bend: arithmetic mod p = 2^130 - 5 for Poly1305 (RFC 8439 section
# 2.5). A field element is ten 13-bit limbs of Nat, least significant first.
# Generated by gen_poly1305.py.

import Base

type F is Data:
  F{l0: Nat, l1: Nat, l2: Nat, l3: Nat, l4: Nat, l5: Nat, l6: Nat, l7: Nat, l8: Nat, l9: Nat}

def pl.zero() -> F:
  F{0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n}

def pl.add(+a: F, +b: F) -> F:
  match a:
    case F{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9}:
      match b:
        case F{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7, +b8, +b9}:
          F{(a0 + b0 : Nat), (a1 + b1 : Nat), (a2 + b2 : Nat), (a3 + b3 : Nat), (a4 + b4 : Nat), (a5 + b5 : Nat), (a6 + b6 : Nat), (a7 + b7 : Nat), (a8 + b8 : Nat), (a9 + b9 : Nat)}

# one carry pass, the top carry wrapping into limb 0 as 5 * carry
def pl.pass(+x: F) -> F:
  match x:
    case F{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9}:
  +q11 = (x0 / 8192n : Nat)
  +q12 = (x0 % 8192n : Nat)
  +q13 = (x1 + q11 : Nat)
  +q14 = (q13 / 8192n : Nat)
  +q15 = (q13 % 8192n : Nat)
  +q16 = (x2 + q14 : Nat)
  +q17 = (q16 / 8192n : Nat)
  +q18 = (q16 % 8192n : Nat)
  +q19 = (x3 + q17 : Nat)
  +q20 = (q19 / 8192n : Nat)
  +q21 = (q19 % 8192n : Nat)
  +q22 = (x4 + q20 : Nat)
  +q23 = (q22 / 8192n : Nat)
  +q24 = (q22 % 8192n : Nat)
  +q25 = (x5 + q23 : Nat)
  +q26 = (q25 / 8192n : Nat)
  +q27 = (q25 % 8192n : Nat)
  +q28 = (x6 + q26 : Nat)
  +q29 = (q28 / 8192n : Nat)
  +q30 = (q28 % 8192n : Nat)
  +q31 = (x7 + q29 : Nat)
  +q32 = (q31 / 8192n : Nat)
  +q33 = (q31 % 8192n : Nat)
  +q34 = (x8 + q32 : Nat)
  +q35 = (q34 / 8192n : Nat)
  +q36 = (q34 % 8192n : Nat)
  +q37 = (x9 + q35 : Nat)
  +q38 = (q37 / 8192n : Nat)
  +q39 = (q37 % 8192n : Nat)
  +q40 = (q12 + 5n * q38 : Nat)
      F{q40, q15, q18, q21, q24, q27, q30, q33, q36, q39}

# two carry passes: every limb back under 2^13 plus a little
def pl.norm(+x: F) -> F:
  pl.pass(pl.pass(x))

# a * r mod p, the products and folds generated
def pl.mul(+a: F, +r: F) -> F:
  match a:
    case F{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9}:
      match r:
        case F{+r0, +r1, +r2, +r3, +r4, +r5, +r6, +r7, +r8, +r9}:
  +q1 = (a0 * r0 + 5n * (a1 * r9 + a2 * r8 + a3 * r7 + a4 * r6 + a5 * r5 + a6 * r4 + a7 * r3 + a8 * r2 + a9 * r1) : Nat)
  +q2 = (a0 * r1 + a1 * r0 + 5n * (a2 * r9 + a3 * r8 + a4 * r7 + a5 * r6 + a6 * r5 + a7 * r4 + a8 * r3 + a9 * r2) : Nat)
  +q3 = (a0 * r2 + a1 * r1 + a2 * r0 + 5n * (a3 * r9 + a4 * r8 + a5 * r7 + a6 * r6 + a7 * r5 + a8 * r4 + a9 * r3) : Nat)
  +q4 = (a0 * r3 + a1 * r2 + a2 * r1 + a3 * r0 + 5n * (a4 * r9 + a5 * r8 + a6 * r7 + a7 * r6 + a8 * r5 + a9 * r4) : Nat)
  +q5 = (a0 * r4 + a1 * r3 + a2 * r2 + a3 * r1 + a4 * r0 + 5n * (a5 * r9 + a6 * r8 + a7 * r7 + a8 * r6 + a9 * r5) : Nat)
  +q6 = (a0 * r5 + a1 * r4 + a2 * r3 + a3 * r2 + a4 * r1 + a5 * r0 + 5n * (a6 * r9 + a7 * r8 + a8 * r7 + a9 * r6) : Nat)
  +q7 = (a0 * r6 + a1 * r5 + a2 * r4 + a3 * r3 + a4 * r2 + a5 * r1 + a6 * r0 + 5n * (a7 * r9 + a8 * r8 + a9 * r7) : Nat)
  +q8 = (a0 * r7 + a1 * r6 + a2 * r5 + a3 * r4 + a4 * r3 + a5 * r2 + a6 * r1 + a7 * r0 + 5n * (a8 * r9 + a9 * r8) : Nat)
  +q9 = (a0 * r8 + a1 * r7 + a2 * r6 + a3 * r5 + a4 * r4 + a5 * r3 + a6 * r2 + a7 * r1 + a8 * r0 + 5n * (a9 * r9) : Nat)
  +q10 = (a0 * r9 + a1 * r8 + a2 * r7 + a3 * r6 + a4 * r5 + a5 * r4 + a6 * r3 + a7 * r2 + a8 * r1 + a9 * r0 : Nat)
          pl.norm(F{q1, q2, q3, q4, q5, q6, q7, q8, q9, q10})

# carries without wrapping: the limbs under 2^13 and the carry out of limb 9
def pl.carrynw(+x: F) -> F & Nat:
  match x:
    case F{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9}:
  +q41 = (x0 / 8192n : Nat)
  +q42 = (x0 % 8192n : Nat)
  +q43 = (x1 + q41 : Nat)
  +q44 = (q43 / 8192n : Nat)
  +q45 = (q43 % 8192n : Nat)
  +q46 = (x2 + q44 : Nat)
  +q47 = (q46 / 8192n : Nat)
  +q48 = (q46 % 8192n : Nat)
  +q49 = (x3 + q47 : Nat)
  +q50 = (q49 / 8192n : Nat)
  +q51 = (q49 % 8192n : Nat)
  +q52 = (x4 + q50 : Nat)
  +q53 = (q52 / 8192n : Nat)
  +q54 = (q52 % 8192n : Nat)
  +q55 = (x5 + q53 : Nat)
  +q56 = (q55 / 8192n : Nat)
  +q57 = (q55 % 8192n : Nat)
  +q58 = (x6 + q56 : Nat)
  +q59 = (q58 / 8192n : Nat)
  +q60 = (q58 % 8192n : Nat)
  +q61 = (x7 + q59 : Nat)
  +q62 = (q61 / 8192n : Nat)
  +q63 = (q61 % 8192n : Nat)
  +q64 = (x8 + q62 : Nat)
  +q65 = (q64 / 8192n : Nat)
  +q66 = (q64 % 8192n : Nat)
  +q67 = (x9 + q65 : Nat)
  +q68 = (q67 / 8192n : Nat)
  +q69 = (q67 % 8192n : Nat)
      (F{q42, q45, q48, q51, q54, q57, q60, q63, q66, q69}, q68)

# x with c added to limb 0
def pl.addl0(+x: F, +c: Nat) -> F:
  match x:
    case F{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9}:
      F{(x0 + c : Nat), x1, x2, x3, x4, x5, x6, x7, x8, x9}

# y < 2^130 is below p, or in [p, 2^130) and then y + 5 carries out of limb 9
def pl.canon.choose(+y: F, +gy: F, gt: Nat) -> F:
  match gt:
    case 0n:
      y
    case 1n+_:
      gy

def pl.canon.pick(+y: F, g: F & Nat) -> F:
  (gy, gt) = g
  pl.canon.choose(y, gy, gt)

def pl.canon.sub(+y: F) -> F:
  pl.canon.pick(y, pl.carrynw(pl.addl0(y, 5n)))

# x mod p, exactly: limbs under 2^13 and the value below p. Each round folds
# the carry out of limb 9 back in (2^130 = 5); four rounds always suffice.
def pl.canon.iter(fuel: Nat, r: F & Nat) -> F:
  match fuel:
    case 0n:
      pl.zero()
    case 1n+p:
      (y, +t) = r
      match t:
        case 0n:
          pl.canon.sub(y)
        case 1n+_:
          pl.canon.iter(p, pl.carrynw(pl.addl0(y, Nat.mul(5n, t))))

def pl.canon(+x: F) -> F:
  pl.canon.iter(4n, pl.carrynw(pl.norm(x)))

# the value of the first k bits of a bit list (weights pw, pw * 2, ...), and
# the list after them
def pl.val(k: Nat, +bits: List<&2, Nat>, +pw: Nat, +acc: Nat) -> Nat:
  match k:
    case 0n:
      acc
    case 1n+p:
      match bits:
        case Nil{}:
          acc
        case b <> t:
          pl.val(p, t, Nat.mul(2n, pw), Nat.add(acc, Nat.mul(b, pw)))

def pl.drop(k: Nat, +bits: List<&2, Nat>) -> List<&2, Nat>:
  match k:
    case 0n:
      bits
    case 1n+p:
      match bits:
        case Nil{}:
          Nil{}
        case b <> t:
          pl.drop(p, t)

# the first n limbs of 13 bits each, least significant first
def pl.limbs(n: Nat, +bits: List<&2, Nat>) -> List<&2, Nat>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      pl.val(13n, bits, 1n, 0n) <> pl.limbs(p, pl.drop(13n, bits))

def pl.of10(xs: List<&2, Nat>) -> F:
  match xs:
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> Nil{}:
      F{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9}
    case _:
      pl.zero()

# the field element of the first 130 bits of a bit list
def pl.of_bits(+bits: List<&2, Nat>) -> F:
  pl.of10(pl.limbs(10n, bits))

# the k low bits of v, least significant first
def pl.bits(k: Nat, +v: Nat) -> List<&2, Nat>:
  match k:
    case 0n:
      Nil{}
    case 1n+p:
      Nat.mod(v, 2n) <> pl.bits(p, Nat.div(v, 2n))

# the bits of a byte list, least significant first within each byte
def pl.bytes_bits(+bs: List<&2, U32>) -> List<&2, Nat>:
  match bs:
    case Nil{}:
      Nil{}
    case b <> t:
      List.append(&2, Nat, pl.bits(8n, U32.to_nat(b)), pl.bytes_bits(t))

# the field element of little-endian bytes (any length up to 16 bytes plus one)
def pl.of_bytes(+bs: List<&2, U32>) -> F:
  pl.of_bits(pl.bytes_bits(bs))

def pl.cat(+a: List<&2, Nat>, +b: List<&2, Nat>) -> List<&2, Nat>:
  List.append(&2, Nat, a, b)

def pl.bits_of(+x: F) -> List<&2, Nat>:
  match x:
    case F{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9}:
      List.take(&2, Nat, pl.cat(pl.bits(13n, x0), pl.cat(pl.bits(13n, x1), pl.cat(pl.bits(13n, x2), pl.cat(pl.bits(13n, x3), pl.cat(pl.bits(13n, x4), pl.cat(pl.bits(13n, x5), pl.cat(pl.bits(13n, x6), pl.cat(pl.bits(13n, x7), pl.cat(pl.bits(13n, x8), pl.bits(13n, x9)))))))))), 128n)


# the bytes of a bit list of length 8k, 8 bits each, least significant first
def pl.pack(+bits: List<&2, Nat>) -> List<&2, U32>:
  match bits:
    case Nil{}:
      Nil{}
    case b0 <> b1 <> b2 <> b3 <> b4 <> b5 <> b6 <> b7 <> t:
      U32.from_nat(Nat.add(b0, Nat.add(Nat.mul(2n, b1), Nat.add(Nat.mul(4n, b2), Nat.add(Nat.mul(8n, b3),
        Nat.add(Nat.mul(16n, b4), Nat.add(Nat.mul(32n, b5), Nat.add(Nat.mul(64n, b6), Nat.mul(128n, b7)))))))))
        <> pl.pack(t)
    case _:
      Nil{}
