# x25519.bend: X25519 (RFC 7748). A field element is sixteen 16-bit Nat limbs,
# least significant first; arithmetic is modulo p = 2^255 - 19. The product
# and the carry chains are generated by gen_x25519.py. Scalars and coordinates
# are 32-byte lists of U32 values 0..255, little-endian as RFC 7748 defines.

import Base

type FE is Data:
  FE{l0: Nat, l1: Nat, l2: Nat, l3: Nat, l4: Nat, l5: Nat, l6: Nat, l7: Nat, l8: Nat, l9: Nat, l10: Nat, l11: Nat, l12: Nat, l13: Nat, l14: Nat, l15: Nat}

def fe.zero() -> FE:
  FE{0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n}

def fe.one() -> FE:
  FE{1n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n}

def fe.add(+a: FE, +b: FE) -> FE:
  match a:
    case FE{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11, +a12, +a13, +a14, +a15}:
      match b:
        case FE{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7, +b8, +b9, +b10, +b11, +b12, +b13, +b14, +b15}:
          FE{(a0 + b0 : Nat), (a1 + b1 : Nat), (a2 + b2 : Nat), (a3 + b3 : Nat), (a4 + b4 : Nat), (a5 + b5 : Nat), (a6 + b6 : Nat), (a7 + b7 : Nat), (a8 + b8 : Nat), (a9 + b9 : Nat), (a10 + b10 : Nat), (a11 + b11 : Nat), (a12 + b12 : Nat), (a13 + b13 : Nat), (a14 + b14 : Nat), (a15 + b15 : Nat)}

# a - b, with 2p added to every limb so none goes negative (b's limbs are below 2^17)
def fe.sub(+a: FE, +b: FE) -> FE:
  match a:
    case FE{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11, +a12, +a13, +a14, +a15}:
      match b:
        case FE{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7, +b8, +b9, +b10, +b11, +b12, +b13, +b14, +b15}:
          FE{(a0 + 65498n - b0 : Nat), (a1 + 65535n - b1 : Nat), (a2 + 65535n - b2 : Nat), (a3 + 65535n - b3 : Nat), (a4 + 65535n - b4 : Nat), (a5 + 65535n - b5 : Nat), (a6 + 65535n - b6 : Nat), (a7 + 65535n - b7 : Nat), (a8 + 65535n - b8 : Nat), (a9 + 65535n - b9 : Nat), (a10 + 65535n - b10 : Nat), (a11 + 65535n - b11 : Nat), (a12 + 65535n - b12 : Nat), (a13 + 65535n - b13 : Nat), (a14 + 65535n - b14 : Nat), (a15 + 65535n - b15 : Nat)}

# one carry pass; the top carry wraps into limb 0 times 38
def fe.pass(+x: FE) -> FE:
  match x:
    case FE{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9, +x10, +x11, +x12, +x13, +x14, +x15}:
        +q17 = (x0 / 65536n : Nat)
        +q18 = (x0 % 65536n : Nat)
        +q19 = (x1 + q17 : Nat)
        +q20 = (q19 / 65536n : Nat)
        +q21 = (q19 % 65536n : Nat)
        +q22 = (x2 + q20 : Nat)
        +q23 = (q22 / 65536n : Nat)
        +q24 = (q22 % 65536n : Nat)
        +q25 = (x3 + q23 : Nat)
        +q26 = (q25 / 65536n : Nat)
        +q27 = (q25 % 65536n : Nat)
        +q28 = (x4 + q26 : Nat)
        +q29 = (q28 / 65536n : Nat)
        +q30 = (q28 % 65536n : Nat)
        +q31 = (x5 + q29 : Nat)
        +q32 = (q31 / 65536n : Nat)
        +q33 = (q31 % 65536n : Nat)
        +q34 = (x6 + q32 : Nat)
        +q35 = (q34 / 65536n : Nat)
        +q36 = (q34 % 65536n : Nat)
        +q37 = (x7 + q35 : Nat)
        +q38 = (q37 / 65536n : Nat)
        +q39 = (q37 % 65536n : Nat)
        +q40 = (x8 + q38 : Nat)
        +q41 = (q40 / 65536n : Nat)
        +q42 = (q40 % 65536n : Nat)
        +q43 = (x9 + q41 : Nat)
        +q44 = (q43 / 65536n : Nat)
        +q45 = (q43 % 65536n : Nat)
        +q46 = (x10 + q44 : Nat)
        +q47 = (q46 / 65536n : Nat)
        +q48 = (q46 % 65536n : Nat)
        +q49 = (x11 + q47 : Nat)
        +q50 = (q49 / 65536n : Nat)
        +q51 = (q49 % 65536n : Nat)
        +q52 = (x12 + q50 : Nat)
        +q53 = (q52 / 65536n : Nat)
        +q54 = (q52 % 65536n : Nat)
        +q55 = (x13 + q53 : Nat)
        +q56 = (q55 / 65536n : Nat)
        +q57 = (q55 % 65536n : Nat)
        +q58 = (x14 + q56 : Nat)
        +q59 = (q58 / 65536n : Nat)
        +q60 = (q58 % 65536n : Nat)
        +q61 = (x15 + q59 : Nat)
        +q62 = (q61 / 65536n : Nat)
        +q63 = (q61 % 65536n : Nat)
        +q64 = (q18 + 38n * q62 : Nat)
      FE{q64, q21, q24, q27, q30, q33, q36, q39, q42, q45, q48, q51, q54, q57, q60, q63}

def fe.norm(+x: FE) -> FE:
  fe.pass(fe.pass(x))

# a * b mod p
def fe.mul(+a: FE, +b: FE) -> FE:
  match a:
    case FE{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11, +a12, +a13, +a14, +a15}:
      match b:
        case FE{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7, +b8, +b9, +b10, +b11, +b12, +b13, +b14, +b15}:
          +q1 = (a0 * b0 + 38n * (a1 * b15 + a2 * b14 + a3 * b13 + a4 * b12 + a5 * b11 + a6 * b10 + a7 * b9 + a8 * b8 + a9 * b7 + a10 * b6 + a11 * b5 + a12 * b4 + a13 * b3 + a14 * b2 + a15 * b1) : Nat)
          +q2 = (a0 * b1 + a1 * b0 + 38n * (a2 * b15 + a3 * b14 + a4 * b13 + a5 * b12 + a6 * b11 + a7 * b10 + a8 * b9 + a9 * b8 + a10 * b7 + a11 * b6 + a12 * b5 + a13 * b4 + a14 * b3 + a15 * b2) : Nat)
          +q3 = (a0 * b2 + a1 * b1 + a2 * b0 + 38n * (a3 * b15 + a4 * b14 + a5 * b13 + a6 * b12 + a7 * b11 + a8 * b10 + a9 * b9 + a10 * b8 + a11 * b7 + a12 * b6 + a13 * b5 + a14 * b4 + a15 * b3) : Nat)
          +q4 = (a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0 + 38n * (a4 * b15 + a5 * b14 + a6 * b13 + a7 * b12 + a8 * b11 + a9 * b10 + a10 * b9 + a11 * b8 + a12 * b7 + a13 * b6 + a14 * b5 + a15 * b4) : Nat)
          +q5 = (a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0 + 38n * (a5 * b15 + a6 * b14 + a7 * b13 + a8 * b12 + a9 * b11 + a10 * b10 + a11 * b9 + a12 * b8 + a13 * b7 + a14 * b6 + a15 * b5) : Nat)
          +q6 = (a0 * b5 + a1 * b4 + a2 * b3 + a3 * b2 + a4 * b1 + a5 * b0 + 38n * (a6 * b15 + a7 * b14 + a8 * b13 + a9 * b12 + a10 * b11 + a11 * b10 + a12 * b9 + a13 * b8 + a14 * b7 + a15 * b6) : Nat)
          +q7 = (a0 * b6 + a1 * b5 + a2 * b4 + a3 * b3 + a4 * b2 + a5 * b1 + a6 * b0 + 38n * (a7 * b15 + a8 * b14 + a9 * b13 + a10 * b12 + a11 * b11 + a12 * b10 + a13 * b9 + a14 * b8 + a15 * b7) : Nat)
          +q8 = (a0 * b7 + a1 * b6 + a2 * b5 + a3 * b4 + a4 * b3 + a5 * b2 + a6 * b1 + a7 * b0 + 38n * (a8 * b15 + a9 * b14 + a10 * b13 + a11 * b12 + a12 * b11 + a13 * b10 + a14 * b9 + a15 * b8) : Nat)
          +q9 = (a0 * b8 + a1 * b7 + a2 * b6 + a3 * b5 + a4 * b4 + a5 * b3 + a6 * b2 + a7 * b1 + a8 * b0 + 38n * (a9 * b15 + a10 * b14 + a11 * b13 + a12 * b12 + a13 * b11 + a14 * b10 + a15 * b9) : Nat)
          +q10 = (a0 * b9 + a1 * b8 + a2 * b7 + a3 * b6 + a4 * b5 + a5 * b4 + a6 * b3 + a7 * b2 + a8 * b1 + a9 * b0 + 38n * (a10 * b15 + a11 * b14 + a12 * b13 + a13 * b12 + a14 * b11 + a15 * b10) : Nat)
          +q11 = (a0 * b10 + a1 * b9 + a2 * b8 + a3 * b7 + a4 * b6 + a5 * b5 + a6 * b4 + a7 * b3 + a8 * b2 + a9 * b1 + a10 * b0 + 38n * (a11 * b15 + a12 * b14 + a13 * b13 + a14 * b12 + a15 * b11) : Nat)
          +q12 = (a0 * b11 + a1 * b10 + a2 * b9 + a3 * b8 + a4 * b7 + a5 * b6 + a6 * b5 + a7 * b4 + a8 * b3 + a9 * b2 + a10 * b1 + a11 * b0 + 38n * (a12 * b15 + a13 * b14 + a14 * b13 + a15 * b12) : Nat)
          +q13 = (a0 * b12 + a1 * b11 + a2 * b10 + a3 * b9 + a4 * b8 + a5 * b7 + a6 * b6 + a7 * b5 + a8 * b4 + a9 * b3 + a10 * b2 + a11 * b1 + a12 * b0 + 38n * (a13 * b15 + a14 * b14 + a15 * b13) : Nat)
          +q14 = (a0 * b13 + a1 * b12 + a2 * b11 + a3 * b10 + a4 * b9 + a5 * b8 + a6 * b7 + a7 * b6 + a8 * b5 + a9 * b4 + a10 * b3 + a11 * b2 + a12 * b1 + a13 * b0 + 38n * (a14 * b15 + a15 * b14) : Nat)
          +q15 = (a0 * b14 + a1 * b13 + a2 * b12 + a3 * b11 + a4 * b10 + a5 * b9 + a6 * b8 + a7 * b7 + a8 * b6 + a9 * b5 + a10 * b4 + a11 * b3 + a12 * b2 + a13 * b1 + a14 * b0 + 38n * (a15 * b15) : Nat)
          +q16 = (a0 * b15 + a1 * b14 + a2 * b13 + a3 * b12 + a4 * b11 + a5 * b10 + a6 * b9 + a7 * b8 + a8 * b7 + a9 * b6 + a10 * b5 + a11 * b4 + a12 * b3 + a13 * b2 + a14 * b1 + a15 * b0 : Nat)
          fe.norm(FE{q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, q11, q12, q13, q14, q15, q16})

def fe.sq(+a: FE) -> FE:
  fe.mul(a, a)

# k * x for a small constant k (the ladder uses 121665)
def fe.mul_small(+x: FE, k: Nat) -> FE:
  fe.mul(x, FE{k, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n})

# one carry pass without the wrap: limbs below 2^16 and the carry out of limb 15
def fe.carrynw(+x: FE) -> FE & Nat:
  match x:
    case FE{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9, +x10, +x11, +x12, +x13, +x14, +x15}:
        +q65 = (x0 / 65536n : Nat)
        +q66 = (x0 % 65536n : Nat)
        +q67 = (x1 + q65 : Nat)
        +q68 = (q67 / 65536n : Nat)
        +q69 = (q67 % 65536n : Nat)
        +q70 = (x2 + q68 : Nat)
        +q71 = (q70 / 65536n : Nat)
        +q72 = (q70 % 65536n : Nat)
        +q73 = (x3 + q71 : Nat)
        +q74 = (q73 / 65536n : Nat)
        +q75 = (q73 % 65536n : Nat)
        +q76 = (x4 + q74 : Nat)
        +q77 = (q76 / 65536n : Nat)
        +q78 = (q76 % 65536n : Nat)
        +q79 = (x5 + q77 : Nat)
        +q80 = (q79 / 65536n : Nat)
        +q81 = (q79 % 65536n : Nat)
        +q82 = (x6 + q80 : Nat)
        +q83 = (q82 / 65536n : Nat)
        +q84 = (q82 % 65536n : Nat)
        +q85 = (x7 + q83 : Nat)
        +q86 = (q85 / 65536n : Nat)
        +q87 = (q85 % 65536n : Nat)
        +q88 = (x8 + q86 : Nat)
        +q89 = (q88 / 65536n : Nat)
        +q90 = (q88 % 65536n : Nat)
        +q91 = (x9 + q89 : Nat)
        +q92 = (q91 / 65536n : Nat)
        +q93 = (q91 % 65536n : Nat)
        +q94 = (x10 + q92 : Nat)
        +q95 = (q94 / 65536n : Nat)
        +q96 = (q94 % 65536n : Nat)
        +q97 = (x11 + q95 : Nat)
        +q98 = (q97 / 65536n : Nat)
        +q99 = (q97 % 65536n : Nat)
        +q100 = (x12 + q98 : Nat)
        +q101 = (q100 / 65536n : Nat)
        +q102 = (q100 % 65536n : Nat)
        +q103 = (x13 + q101 : Nat)
        +q104 = (q103 / 65536n : Nat)
        +q105 = (q103 % 65536n : Nat)
        +q106 = (x14 + q104 : Nat)
        +q107 = (q106 / 65536n : Nat)
        +q108 = (q106 % 65536n : Nat)
        +q109 = (x15 + q107 : Nat)
        +q110 = (q109 / 65536n : Nat)
        +q111 = (q109 % 65536n : Nat)
      (FE{q66, q69, q72, q75, q78, q81, q84, q87, q90, q93, q96, q99, q102, q105, q108, q111}, q110)

def fe.addl0(+x: FE, +c: Nat) -> FE:
  match x:
    case FE{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9, +x10, +x11, +x12, +x13, +x14, +x15}:
      FE{(x0 + c : Nat), x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}

# bit 255 of x, and x with bit 255 cleared
def fe.hi255(+x: FE) -> Nat:
  match x:
    case FE{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9, +x10, +x11, +x12, +x13, +x14, +x15}:
      Nat.div(x15, 32768n)

def fe.low255(+x: FE) -> FE:
  match x:
    case FE{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9, +x10, +x11, +x12, +x13, +x14, +x15}:
      FE{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, Nat.mod(x15, 32768n)}

# x (limbs exact, value below 2^256) reduced once: fold bit 255 as 19
def fe.cB3(+w: FE, h: Nat, +gg: FE) -> FE:
  match h:
    case 0n:
      w
    case 1n+_:
      fe.low255(gg)

# repeat the carry until the top carry is zero, so the value is below 2^256
def fe.cB2(+w: FE, g: FE & Nat) -> FE:
  (+gg, t) = g
  fe.cB3(w, fe.hi255(gg), gg)

def fe.cB(+w: FE) -> FE:
  fe.cB2(w, fe.carrynw(fe.addl0(w, 19n)))

def fe.cA2(r: FE & Nat) -> FE:
  (w, t) = r
  fe.cB(w)

# w below 2^255 + 19: subtract p when w + 19 reaches 2^255
def fe.cA(+y: FE) -> FE:
  fe.cA2(fe.carrynw(fe.addl0(fe.low255(y), Nat.mul(19n, fe.hi255(y)))))

def fe.cfold(fuel: Nat, r: FE & Nat) -> FE:
  match fuel:
    case 0n:
      fe.zero()
    case 1n+p:
      (y, +t) = r
      match t:
        case 0n:
          fe.cA(y)
        case 1n+_:
          fe.cfold(p, fe.carrynw(fe.addl0(y, Nat.mul(38n, t))))

# x mod p, canonical: limbs below 2^16 and the value below p
def fe.canon(+x: FE) -> FE:
  fe.cfold(4n, fe.carrynw(fe.norm(x)))

# the 32 little-endian bytes of x (x canonical)
def fe.bytes(+x: FE) -> List<&2, Nat>:
  match x:
    case FE{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9, +x10, +x11, +x12, +x13, +x14, +x15}:
      Nat.mod(x0, 256n) <> Nat.div(x0, 256n) <> Nat.mod(x1, 256n) <> Nat.div(x1, 256n) <> Nat.mod(x2, 256n) <> Nat.div(x2, 256n) <> Nat.mod(x3, 256n) <> Nat.div(x3, 256n) <> Nat.mod(x4, 256n) <> Nat.div(x4, 256n) <> Nat.mod(x5, 256n) <> Nat.div(x5, 256n) <> Nat.mod(x6, 256n) <> Nat.div(x6, 256n) <> Nat.mod(x7, 256n) <> Nat.div(x7, 256n) <> Nat.mod(x8, 256n) <> Nat.div(x8, 256n) <> Nat.mod(x9, 256n) <> Nat.div(x9, 256n) <> Nat.mod(x10, 256n) <> Nat.div(x10, 256n) <> Nat.mod(x11, 256n) <> Nat.div(x11, 256n) <> Nat.mod(x12, 256n) <> Nat.div(x12, 256n) <> Nat.mod(x13, 256n) <> Nat.div(x13, 256n) <> Nat.mod(x14, 256n) <> Nat.div(x14, 256n) <> Nat.mod(x15, 256n) <> Nat.div(x15, 256n) <> Nil{}

# the field element of 32 little-endian bytes (bit 255 is ignored)
def fe.of_bytes(b: List<&2, Nat>) -> FE:
  match b:
    case b0 <> b1 <> b2 <> b3 <> b4 <> b5 <> b6 <> b7 <> b8 <> b9 <> b10 <> b11 <> b12 <> b13 <> b14 <> b15 <> b16 <> b17 <> b18 <> b19 <> b20 <> b21 <> b22 <> b23 <> b24 <> b25 <> b26 <> b27 <> b28 <> b29 <> b30 <> b31 <> Nil{}:
      FE{(b0 + Nat.mul(256n, b1) : Nat), (b2 + Nat.mul(256n, b3) : Nat), (b4 + Nat.mul(256n, b5) : Nat), (b6 + Nat.mul(256n, b7) : Nat), (b8 + Nat.mul(256n, b9) : Nat), (b10 + Nat.mul(256n, b11) : Nat), (b12 + Nat.mul(256n, b13) : Nat), (b14 + Nat.mul(256n, b15) : Nat), (b16 + Nat.mul(256n, b17) : Nat), (b18 + Nat.mul(256n, b19) : Nat), (b20 + Nat.mul(256n, b21) : Nat), (b22 + Nat.mul(256n, b23) : Nat), (b24 + Nat.mul(256n, b25) : Nat), (b26 + Nat.mul(256n, b27) : Nat), (b28 + Nat.mul(256n, b29) : Nat), (b30 + Nat.mul(256n, Nat.mod(b31, 128n)) : Nat)}
    case _:
      fe.zero()

# z^e square-and-multiply, bits of e most significant first
def fe.pow.step(b: Nat, +x: FE, +r2: FE) -> FE:
  match b:
    case 0n:
      r2
    case 1n+_:
      fe.mul(r2, x)

# 1/z = z^(p-2)
def fe.pow(bits: List<&2, Nat>, +x: FE, +r: FE) -> FE:
  match bits:
    case Nil{}:
      r
    case b <> t:
      fe.pow(t, x, fe.pow.step(b, x, fe.sq(r)))

def fe.inv(+z: FE) -> FE:
  fe.pow([1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 0n, 1n, 0n, 1n, 1n], z, fe.one())

def fe.pick(s: Nat, +a: FE, +b: FE) -> FE:
  match s:
    case 0n:
      a
    case 1n+_:
      b

# the Montgomery ladder state: x2, z2, x3, z3, and the swap bit
type LS is Data:
  LS{x2: FE, z2: FE, x3: FE, z3: FE, swap: Nat}

# one ladder step for scalar bit b (RFC 7748 section 5)
def ladder.step(+b: Nat, +st: LS, +u: FE) -> LS:
  match st:
    case LS{+x2, +z2, +x3, +z3, +swap}:
        +sw = Nat.mod(Nat.add(swap, b), 2n)
        +X2 = fe.pick(sw, x2, x3)
        +X3 = fe.pick(sw, x3, x2)
        +Z2 = fe.pick(sw, z2, z3)
        +Z3 = fe.pick(sw, z3, z2)
        +A = fe.add(X2, Z2)
        +AA = fe.sq(A)
        +B = fe.sub(X2, Z2)
        +BB = fe.sq(B)
        +E = fe.sub(AA, BB)
        +C = fe.add(X3, Z3)
        +D = fe.sub(X3, Z3)
        +DA = fe.mul(D, A)
        +CB = fe.mul(C, B)
        +nx3 = fe.sq(fe.add(DA, CB))
        +nz3 = fe.mul(u, fe.sq(fe.sub(DA, CB)))
        +nx2 = fe.mul(AA, BB)
        +nz2 = fe.mul(E, fe.add(AA, fe.mul_small(E, 121665n)))
        LS{nx2, nz2, nx3, nz3, b}

def ladder(bits: List<&2, Nat>, +st: LS, +u: FE) -> LS:
  match bits:
    case Nil{}:
      st
    case b <> t:
      ladder(t, ladder.step(b, st, u), u)

# the scalar with the RFC 7748 clamping, as a 255-bit list, most significant first
def x25519.clamp(k: List<&2, U32>) -> List<&2, U32>:
  match k:
    case k0 <> k1 <> k2 <> k3 <> k4 <> k5 <> k6 <> k7 <> k8 <> k9 <> k10 <> k11 <> k12 <> k13 <> k14 <> k15 <> k16 <> k17 <> k18 <> k19 <> k20 <> k21 <> k22 <> k23 <> k24 <> k25 <> k26 <> k27 <> k28 <> k29 <> k30 <> k31 <> Nil{}:
      U32.and(k0, 248) <> k1 <> k2 <> k3 <> k4 <> k5 <> k6 <> k7 <> k8 <> k9 <> k10 <> k11
        <> k12 <> k13 <> k14 <> k15 <> k16 <> k17 <> k18 <> k19 <> k20 <> k21 <> k22 <> k23
        <> k24 <> k25 <> k26 <> k27 <> k28 <> k29 <> k30 <> U32.or(U32.and(k31, 127), 64) <> Nil{}
    case _:
      Nil{}

def x25519.tonat(xs: List<&2, U32>) -> List<&2, Nat>:
  match xs:
    case Nil{}:
      Nil{}
    case x <> t:
      U32.to_nat(x) <> x25519.tonat(t)

def x25519.tou32(xs: List<&2, Nat>) -> List<&2, U32>:
  match xs:
    case Nil{}:
      Nil{}
    case x <> t:
      U32.from_nat(x) <> x25519.tou32(t)

# the bits of a byte, least significant first
def x25519.bits(k: Nat, +v: Nat) -> List<&2, Nat>:
  match k:
    case 0n:
      Nil{}
    case 1n+p:
      Nat.mod(v, 2n) <> x25519.bits(p, Nat.div(v, 2n))

def x25519.bitlist(+bs: List<&2, Nat>) -> List<&2, Nat>:
  match bs:
    case Nil{}:
      Nil{}
    case b <> t:
      List.append(&2, Nat, x25519.bits(8n, b), x25519.bitlist(t))

# the 255 scalar bits, most significant first (bit 255 is zero after clamping)
def x25519.scalar_bits(k: List<&2, U32>) -> List<&2, Nat>:
  List.reverse(&2, Nat, List.take(&2, Nat, x25519.bitlist(x25519.tonat(x25519.clamp(k))), 255n))

# X25519(k, u): the scalar k times the point with u-coordinate u, 32 bytes out
def x25519.out(st: LS) -> List<&2, U32>:
  match st:
    case LS{+x2, +z2, +x3, +z3, +swap}:
      x25519.tou32(fe.bytes(fe.canon(fe.mul(fe.pick(swap, x2, x3), fe.inv(fe.pick(swap, z2, z3))))))

def x25519(k: List<&2, U32>, u: List<&2, U32>) -> List<&2, U32>:
  +uu = fe.of_bytes(x25519.tonat(u))
  +st = ladder(x25519.scalar_bits(k), LS{fe.one(), fe.zero(), uu, fe.one(), 0n}, uu)
  x25519.out(st)
