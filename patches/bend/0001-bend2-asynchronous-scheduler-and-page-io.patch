+function io_node(name) {
+  return globalThis.process?.getBuiltinModule?.(name) ?? null;
+}
+
+// A page has no file descriptors: its output goes to globalThis.bend_stdout(fd, text) when the page
+// sets that, else to the element #bend-output, else to the console.
+function io_page_out(fd, data) {
+  const text = new TextDecoder().decode(data);
+  if (typeof globalThis.bend_stdout === "function") {
+    globalThis.bend_stdout(fd, text);
+    return;
+  }
+  const el = globalThis.document?.getElementById("bend-output");
+  if (el) {
+    el.textContent += text;
+    return;
+  }
+  (fd === 2 ? console.error : console.log)(text.replace(/\n$/, ""));
+}
