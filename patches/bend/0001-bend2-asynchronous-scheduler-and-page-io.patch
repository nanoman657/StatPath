+// An external wait is parked with no fd and at = Infinity: its event (a message, a host
+// timer) calls io_notify, and the next io_wait calls its more() to see whether it is done.
+// The runtime never blocks in select for an external wait, so an event loop can run.
+let io_woke = false;
+let io_wake = null;
+
+function io_notify() {
+  io_woke = true;
+  const f = io_wake;
+  io_wake = null;
+  if (f !== null) f();
+}
+
+// Waits without an fd (timers, external events) end on their deadline or a notice; a wait on an
+// fd keeps the blocking poll of the native runtime.
+async function io_wait_async(io) {
+  if (io.waits.some((w) => w.fd !== undefined)) {
+    io_wait(io, true);
+    return;
+  }
+  if (!io_woke) {
+    const soon = io.waits[0]?.at ?? Infinity;
+    await new Promise((resolve) => {
+      io_wake = resolve;
+      if (soon !== Infinity) {
+        setTimeout(resolve, Math.max(0, soon - performance.now()));
+      }
+    });
+    io_wake = null;
+  }
+  io_wait(io, false);
+}
+
+// The run loop, as steps: it yields where it has nothing to run and must wait. The top-level run
+// waits on the event loop (io_wait_async); a nested run, which is called from an effect and
+// cannot wait, polls as the native runtime always did (io_wait with block).
+function* io_steps(io, m) {
+  io_push(run_loop(m()), (x) => ({ $: "Emit", value: x }), true);
+  let look = 0;
+  for (let n = 0;; n += 1) {
+    if (io.runs.length === 0) {
+      if (io.live === 0) {
+        return 0;
+      }
+      if (io.waits.length === 0) {
+        io_errs("bend: deadlock: every computation waits on a channel");
+        return 1;
+      }
+      yield;
+      continue;
+    }
+    if ((n & 63) === 0 && io.waits.length > 0) {
+      const now = performance.now();
+      if (now >= look || io.waits[0].at <= now) {
+        look = now + 10;
+        io_wait(io, false);
+      }
+    }
+    const s = io.runs.shift();
+    let op = s.fun(s.arg);
+    for (let left = 64; op !== undefined; left -= 1) {
+      if (op.$ === "Emit") {
+        io.live -= 1;
+        break;
+      }
+      if (op.$ === "Halt" || op.$ === "Exit") {
+        if (op.$ === "Halt") io_errs(op.message);
+        if (op.code > 255) {
+          io_errs("bend: exit code must be in 0..255");
           return 1;
         }
-        io_wait(io, true);
-        continue;
+        return op.code;
       }
-      if ((n & 63) === 0 && io.waits.length > 0) {
-        const now = performance.now();
-        if (now >= look || io.waits[0].at <= now) {
-          look = now + 10;
-          io_wait(io, false);
-        }
+      const run = $0eff[op.$];
+      if (run === undefined) {
+        throw "bend: no effect registers " + op.$;
       }
-      const s = io.runs.shift();
-      let op = s.fun(s.arg);
-      for (let left = 64; op !== undefined; left -= 1) {
-        if (op.$ === "Emit") {
-          io.live -= 1;
-          break;
-        }
-        if (op.$ === "Halt" || op.$ === "Exit") {
-          if (op.$ === "Halt") io_errs(op.message);
-          if (op.code > 255) {
-            io_errs("bend: exit code must be in 0..255");
-            return 1;
-          }
-          return op.code;
-        }
-        const run = $0eff[op.$];
-        if (run === undefined) {
-          throw "bend: no effect registers " + op.$;
-        }
-        const x = run(...op.args, op.kont);
-        if (x === undefined) {
-          break;
-        }
-        if (left === 1) {
-          io_push(op.kont, x, false, io);
-          break;
-        }
-        op = op.kont(x);
+      const x = run(...op.args, op.kont);
+      if (x === undefined) {
+        break;
       }
+      if (left === 1) {
+        io_push(op.kont, x, false, io);
+        break;
+      }
+      op = op.kont(x);
+    }
+  }
+}
+
+// The top-level run: an external event ends a wait, so the event loop keeps running.
+async function io_run_async(m) {
+  const io = { runs: [], live: 0, waits: [] };
+  const parent = io_active;
+  io_active = io;
+  try {
+    const steps = io_steps(io, m);
+    for (let r = steps.next(); ; r = steps.next()) {
+      if (r.done) return r.value;
+      await io_wait_async(io);
+    }
+  } catch (e) {
+    throw e instanceof RangeError ? "bend: ${ERRS[7]}" : e;
+  } finally {
+    io_sync();
+    io.done = true;
+    io_active = parent;
+  }
+}
+
+// A nested run (called from an effect, so it cannot await): the blocking poll, as before.
+function io_run(m) {
+  const io = { runs: [], live: 0, waits: [] };
+  const parent = io_active;
+  io_active = io;
+  try {
+    const steps = io_steps(io, m);
+    for (let r = steps.next(); ; r = steps.next()) {
+      if (r.done) return r.value;
+      io_wait(io, true);
     }
   } catch (e) {
     throw e instanceof RangeError ? "bend: ${ERRS[7]}" : e;
